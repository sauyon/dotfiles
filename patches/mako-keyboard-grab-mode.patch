+// mako bundles zwlr_layer_shell_v1 version 1, where set_keyboard_interactivity
+// takes a bare uint -- the KEYBOARD_INTERACTIVITY enum (and ON_DEMAND) only
+// arrived in version 4. 1 is exclusive focus, which is what a modal grab wants.
+#define MAKO_KEYBOARD_INTERACTIVITY_NONE 0
+#define MAKO_KEYBOARD_INTERACTIVITY_EXCLUSIVE 1
+
 static void noop() {
