ss \"the GUI outlives the parent that spawned it (orca-ide open)\"\n   215\telse fail \"GUI lifetime\" \"payload died with its spawning parent\"; fi\n   216\t\n   217\t# The manifest travels with the extracted AppImage, which the CLI's runScript\n   218\t# references, so it is in the CLI's closure.\n   219\tcontents=$(nix-store -qR \"$CLI\" | while read -r p; do\n   220\t  [ -f \"$p/resources/skills/current-manifest.json\" ] && echo \"$p\"; done | head -1)\n   221\t[ -n \"$contents\" ] || { echo \"no extracted AppImage in the closure of $CLI\" >&2; exit 1; }\n   222\tmanifest=\"$contents/resources/skills/current-manifest.json\"\n   223\t\n   224\t# Outside an Orca terminal: none of its env, none of its shim dir on PATH.\n   225\tclean_path=$(printf '%s' \"$PATH\" | tr ':' '\\n' | grep -v 'linux-orca-cli-shim' | paste -sd:)\n   226\toutside() { env $(compgen -e | grep '^ORCA_' | sed 's/^/-u /') PATH=\"$clean_path\" \"$@\"; }\n   227\t\n   228\tgot=$(outside \"$CLI/bin/orca\" --version 2>&1)\n   229\tif printf '%s' \"$got\" | grep -qwF \"$want_version\"; then pass \"orca --version reports $want_version outside Orca\"\n   230\telse fail \"orca --version\" \"got '$got', want $want_version\"; fi\n   231\t\n   232\t# What every skill stub runs, under both names the stubs choose between.\n   233\tfor b in orca-ide orca; do\n   234\t  got=$(outside \"$CLI/bin/$b\" skills get orca-cli 2>&1)\n   235\t  if printf '%s' \"$got\" | grep -q '^# Orca CLI'; then pass \"$b skills get orca-cli prints the guide outside Orca\"\n   236\t  else fail \"$b skills get\" \"$(printf '%s' \"$got\" | head -3)\"; fi\n   237\tdone\n   238\t\n   239\t# The rev is pinned by hand next to the version; the app knows its own.\n   240\trev=$(nix eval --raw \"$HM.home.file\" --apply 'f: f.\".claude/skills/orca-cli\".source' | sed -nE 's|.*-orca-skills-([0-9a-f]{40})/.*|\\1|p')\n   241\tif [ -n \"$rev\" ] && grep -aqF \"sourceCommit:\\`$rev\\`\" \"$contents/resources/app.asar\"; then\n   242\t  pass \"skills rev ${rev:0:8} is this build's sourceCommit\"\n   243\telse fail \"skills rev\" \"'${rev:-unparsed}' is not the sourceCommit in app.asar\"; fi\n   244\t\n   245\tfor s in $SKILLS; do\n   246\t  src=$(nix eval --raw \"$HM.home.file\" --apply \"f: toString f.\\\".claude/skills/$s\\\".source\" 2>/dev/null) \\\n   247\t    || { fail \"$s\" \"no home.file .claude/skills/$s\"; continue; }\n   248\t  # The source is a subpath of a fetch; realise the fetch's derivation itself.\n   249\t  srcdrv=$(nix eval --raw \"$HM.home.file\" --apply \\\n   250\t    \"f: builtins.head (builtins.attrNames (builtins.getContext f.\\\".claude/skills/$s\\\".source))\" 2>/dev/null)\n   251\t  nix-store --realise \"$srcdrv\" >/dev/null\n   252\t  # Every file the manifest lists for the skill, as \"<sha256>  <path>\" lines.\n   253\t  want=$(jq -r --arg n \"$s\" '.skills[] | select(.name == $n) | .files[] | \"\\(.exactSha256)  \\(.path)\"' \"$manifest\")\n   254\t  [ -n \"$want\" ] || { fail \"$s\" \"no entry in the manifest\"; continue; }\n   255\t  if out=$(cd \"$src\" 2>/dev/null && printf '%s\\n' \"$want\" | sha256sum --quiet -c - 2>&1); then\n   256\t    pass \"$s matches this build's manifest ($(printf '%s\\n' \"$want\" | wc -l) files)\"\n   257\t  else fail \"$s\" \"${out:-$src is missing}\"; fi\n   258\tdone\n   259\t\n   260\tprintf '\\n%d/%d passed\\n' \"$((n-fails))\" \"$n\"\n   261\t[ \"$fails\" -eq 0 ]\n# Ad-hoc evaluation and test runs on the in-cluster runner, so a \"does this\n# still evaluate?\" check costs nothing on the laptop.\n#\n# Driven by `hmeval --ci` (home.nix), which commits the working tree — dirty or\n# not — to an `eval/**` branch and reads the result back out of this job's log.\n# The branch is throwaway and `hmeval` deletes it afterwards.\n#\n# This does NOT push to attic. nix-home.yml owns the closure cache; this job\n# only answers a question, so a scratch eval cannot poison the cache with paths\n# built from a commit that never reached master.\nname: nix-eval\n\non:\n  push:\n    branches: [\"eval/**\"]\n  workflow_dispatch:\n\n# Unlike nix-home.yml, this one cancels. A closure build that gets discarded\n# wastes twenty minutes of work someone is waiting on; a superseded eval is\n# just a stale answer, and `hmeval` is already watching the newer run.\nconcurrency:\n  group: nix-eval-${{ github.ref }}\n  cancel-in-progress: true\n\njobs:\n  eval:\n    # Same runner and image as nix-home.yml, for the same reasons — see\n    # docs/ci-nix-home.md before changing either. In particular: no `uses:`\n    # steps (the image has no node), and no awk/sed/grep, which is why the\n    # request file below is parsed in pure bash.\n    runs-on: privileged\n    container:\n      image: nixos/nix@sha256:1a711b619c8a713eff32c3f8d8781b3b4d0130cb91c0a57f67e87abfeeb90b01\n    env:\n      NIX_CONFIG: |\n        experimental-features = nix-command flakes\n        netrc-file = /root/.config/nix/netrc\n        extra-substituters = http://attic.attic.svc.cluster.local/kube\n        extra-trusted-public-keys = kube:REDACTED\n        max-jobs = 6\n        cores = 4\n        sandbox = true\n      # Pinned the same way nix-home.yml pins its attic-client: the image ships\n      # no coreutils/grep/jq, and the test scripts in tests/ assume a normal\n      # userland. One rev for both, so a bump moves them together.\n      TOOLS_REV: 29916453413845e54a65b8a1cf996842300cd299\n      # Which host tests/ should believe it is running on; see the tests branch\n      # below. Any host with a full desktop config will do.\n      TEST_HOST: utsuho\n    steps:\n      - name: authorise nix against attic\n        env:\n          ATTIC_TOKEN: ${{ secrets.ATTIC_TOKEN }}\n        run: |\n          set -eu\n          mkdir -p /root/.config/nix\n          umask 077\n          printf 'machine %s password %s\\n' \\\n            attic.attic.svc.cluster.local \"$ATTIC_TOKEN\" \\\n            > /root/.config/nix/netrc\n          printf 'machine %s password %s\\n' \\\n            attic.ko.ag \"$ATTIC_TOKEN\" \\\n            >> /root/.config/nix/netrc\n\n      - name: checkout\n        run: |\n          set -eu\n          git clone https://forge.ko.ag/${{ github.repository }}.git .\n          git checkout --detach ${{ github.sha }}\n          git --no-pager log -1 --oneline\n\n      # Do NOT echo $FORGE_TOKEN or enable `set -x` here.\n      - name: authorise git against the private input\n        env:\n          FORGE_TOKEN: ${{ secrets.FORGE_TOKEN }}\n        run: |\n          set -eu\n          git config --global credential.\"https://forge.ko.ag\".username oauth2\n          git config --global credential.\"https://forge.ko.ag\".helper \\\n            '!f() { test \"$1\" = get && printf \"password=%s\\n\" \"$FORGE_TOKEN\"; }; f'\n\n      # The whole contract with `hmeval` is this file plus the two markers\n      # below. Keep them in step: hmeval slices the job log between them, so a\n      # renamed marker silently turns every run into \"no output\".\n      - name: run the request\n        env:\n          # Load-bearing, and not obviously so. The credential helper configured\n          # in the previous step answers out of $FORGE_TOKEN *at the moment nix\n          # shells out to git*, which is here — so a helper installed globally\n          # but an env set only on the earlier step leaves this one answering\n          # with an empty password. The failure is not an auth error either; it\n          # surfaces as `error: Failed to fetch git repository\n          # 'https://forge.ko.ag/sauyon/dotfiles-private.git'` partway down a\n          # stack trace about home.activation, which reads like a broken config.\n          # nix-home.yml sets it on its build step for exactly this reason.\n          FORGE_TOKEN: ${{ secrets.FORGE_TOKEN }}\n        run: |\n          set -eu\n\n          req=.hmeval-request\n          if [ ! -f \"$req\" ]; then\n            echo \"no $req in this commit — nothing to run.\"\n            echo \"This workflow is driven by \\`hmeval --ci\\`; pushing an eval/**\"\n            echo \"branch by hand does not carry a request.\"\n            exit 1\n          fi\n\n          # Pure bash: no awk/sed/grep in this image. Values are single-line by\n          # construction (hmeval rejects newlines before it writes the file).\n          mode=; hosts=; tests=; attr=\n          while IFS='=' read -r k v; do\n            case \"$k\" in\n              mode)  mode=$v ;;\n              hosts) hosts=$v ;;\n              tests) tests=$v ;;\n              attr)  attr=$v ;;\n            esac\n          done < \"$req\"\n\n          echo \"hmeval: mode=$mode\"\n          echo \"---8<--- hmeval\"\n          rc=0\n\n          # $hosts and $tests are unquoted in the loops below ON PURPOSE: they\n          # are space-separated lists and the word splitting is the mechanism.\n          # Quoting them turns the whole list into one argument, which fails as\n          # \"attribute 'utsuho fujiwara ...' missing\" rather than as a syntax\n          # error, so it looks like a broken flake instead of a broken quote.\n          # hmeval guarantees they contain no other whitespace.\n\n          case \"$mode\" in\n            eval)\n              # --no-link/--raw keeps this to evaluation plus whatever IFD the\n              # config genuinely needs; nothing is pushed anywhere.\n              for h in $hosts; do\n                if out=$(nix eval --raw \".#homeConfigurations.$h.activationPackage.drvPath\"); then\n                  printf '  %-10s %s\\n' \"$h\" \"$out\"\n                else\n                  printf '  %-10s FAILED\\n' \"$h\"\n                  rc=1\n                fi\n              done\n              ;;\n            attr)\n              if out=$(nix eval --raw \".#$attr\"); then\n                printf '  %s\\n' \"$out\"\n              else\n                printf '  FAILED: .#%s\\n' \"$attr\"\n                rc=1\n              fi\n              ;;\n            tests)\n              # Several scripts in tests/ build the thing they test by way of\n              # `homeConfigurations.$(cat /etc/hostname)` — fine on a box that\n              # is one of the hosts, useless in a container whose hostname is\n              # its own ID. Run 137 died twice over with\n              #\n              #   does not provide attribute\n              #   'homeConfigurations.328998cea6c4.config.home.packages'\n              #\n              # Rather than teach eight scripts a new seam, tell the ephemeral\n              # container it is a host. It only ever needs to be *a* host whose\n              # config contains the script under test; utsuho has all of them.\n              printf '%s' \"$TEST_HOST\" > /etc/hostname\n              echo \"  (as $TEST_HOST)\"\n\n              # tests/*.sh are ordinary shell: they want coreutils, grep, sed\n              # and jq, none of which the nix image has. Run them inside a\n              # pinned shell rather than teaching each script to cope.\n              tools=\"github:NixOS/nixpkgs/$TOOLS_REV\"\n              for t in $tests; do\n                echo \"  === $t\"\n                if nix shell \\\n                     \"$tools#bash\" \"$tools#coreutils\" \"$tools#gnugrep\" \\\n                     \"$tools#gnused\" \"$tools#gawk\" \"$tools#git\" \\\n                     \"$tools#jq\" \"$tools#diffutils\" \\\n                     -c bash \"$t\"; then\n                  echo \"  === $t PASSED\"\n                else\n                  echo \"  === $t FAILED\"\n                  rc=1\n                fi\n              done\n              ;;\n            *)\n              echo \"  unknown mode: $mode\"\n              rc=1\n              ;;\n          esac\n\n          echo \"---8<--- end\"\n          exit $rc\ndiff --git a/tests/sandbox-fonts.sh b/tests/sandbox-fonts.sh\nindex 8061ca50..7ed64b4a 100755\n--- a/tests/sandbox-fonts.sh\n+++ b/tests/sandbox-fonts.sh\n@@ -22,7 +22,7 @@\n # Usage:\n #   tests/sandbox-fonts.sh               build this host's orca and test it\n #   tests/sandbox-fonts.sh <orca-path>   test a given build, e.g. the live one:\n-#                                        $(dirname $(dirname $(readlink -f ~/.nix-profile/bin/orca-ide)))\n+#                                        $(dirname $(dirname $(readlink -f ~/.nix-profile/bin/orca-ide-app)))\n \n set -u\n set -o pipefail\n@@ -34,7 +34,7 @@ fail() { n=$((n+1)); echo \"FAIL $1: $2\"; fails=$((fails+1)); }\n ORCA=\"${1:-}\"\n if [ -z \"$ORCA\" ]; then\n   FLAKE=$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/..\" && pwd)\n-  drv=$(nix eval --raw \"$FLAKE#homeConfigurations.$(cat /etc/hostname).config.home.packages\" \\\n+  drv=$(nix eval --raw \"$FLAKE#homeConfigurations.$(cat /etc/hostname 2>/dev/null || uname -n).config.home.packages\" \\\n     --apply 'ps: (builtins.head (builtins.filter (p: builtins.match \".*orca-[0-9.]+\" (p.name or \"\") != null) ps)).drvPath') \\\n     || { echo \"orca is not in home.packages here\" >&2; exit 1; }\n   ORCA=$(nix-store --realise \"$drv\" | tail -1) || { echo \"could not build orca\" >&2; exit 1; }","is_error":false}]},"uuid":"19673fc0-9f89-4828-adb5-036cd44f7ae9","timestamp":"2026-10-24T12:29:31.123Z","toolUseResult":{"stdout":"     1\t#!/usr/bin/env bash\n     2\t# Cases for the claims orca.nix makes about the Orca CLI and its agent skills:\n     3\t# that `orca-ide` and `orca` are the CLI and run from any shell, not only an\n     4\t# Orca terminal, and that the skills in ~/.claude/skills are the bytes this\n     5\t# Orca build expects. Also its launchers: node mode, signals forwarded into\n     6\t# the sandbox (so `orca-ide serve` stops cleanly), Ctrl-C, and a GUI that\n     7\t# outlives `orca-ide open`.\n     8\t#\n     9\t# Why this needs a test. Orca's own installer only reaches an Orca terminal: it\n    10\t# puts a shim dir on PATH there (ORCA_CLI_BIN_DIR) and symlinks\n    11\t# ~/.local/bin/orca-ide at a raw /nix/store path, a script that runs Electron\n    12\t# against the host's libraries outside the FHS env. The skills are stubs\n    13\t# that tell the agent to run `orca-ide skills get <name>`, so a skill without a\n    14\t# working CLI is a dead end. And the skills are pinned to a commit separately\n    15\t# from the AppImage version; bumping one without the other silently installs\n    16\t# guides for a different CLI. Orca ships the expected hashes in\n    17\t# resources/skills/current-manifest.json, so that is what the files are held to.\n    18\t#\n    19\t# Usage:\n    20\t#   tests/orca-cli-skills.sh    eval + build this host's config and test it\n    21\t\n    22\tset -u\n    23\tset -o pipefail\n    24\t\n    25\tfails=0; n=0\n    26\tpass() { n=$((n+1)); echo \"ok   $1\"; }\n    27\tfail() { n=$((n+1)); echo \"FAIL $1: $2\"; fails=$((fails+1)); }\n    28\tT=$(mktemp -d); trap 'rm -rf \"$T\"' EXIT\n    29\t\n    30\tFLAKE=$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/..\" && pwd)\n    31\t# /etc/hostname is what CI writes to say which host it is; Orca's sandbox does\n    32\t# not bind it in, so fall back to uname -n there.\n    33\tHM=\"$FLAKE#homeConfigurations.$(cat /etc/hostname 2>/dev/null || uname -n).config\"\n    34\tSKILLS=\"orca-cli orchestration computer-use orca-per-workspace-env orca-linear linear-tickets\"\n    35\t\n    36\tpkg_attr() { # pkg_attr <pname> <attr>\n    37\t  nix eval --raw \"$HM.home.packages\" \\\n    38\t    --apply \"ps: (builtins.head (builtins.filter (p: (p.pname or \\\"\\\") == \\\"$1\\\") ps)).$2\"\n    39\t}\n    40\tdrv=$(pkg_attr orca-cli drvPath) || { echo \"no orca-cli in home.packages here\" >&2; exit 1; }\n    41\twant_version=$(pkg_attr orca-cli version) && [ -n \"$want_version\" ] \\\n    42\t  || { echo \"orca-cli has no version\" >&2; exit 1; }\n    43\tCLI=$(nix-store --realise \"$drv\" | tail -1) || { echo \"could not build orca-cli\" >&2; exit 1; }\n    44\tgui_drv=$(pkg_attr orca drvPath) || { echo \"no orca in home.packages here\" >&2; exit 1; }\n    45\tGUI=$(nix-store --realise \"$gui_drv\" | tail -1) || { echo \"could not build orca\" >&2; exit 1; }\n    46\techo \"testing $CLI and $GUI\"\n    47\t\n    48\t# The skills' own rule: outside an Orca terminal, on Linux, the CLI is\n    49\t# `orca-ide`; elsewhere it is `orca`. Both names must be the CLI, and the GUI\n    50\t# must not also claim `orca-ide` -- in the profile it would shadow one of them.\n    51\tfor b in orca orca-ide; do\n    52\t  if [ -x \"$CLI/bin/$b\" ]; then pass \"orca-cli provides bin/$b\"\n    53\t  else fail \"bin/$b\" \"missing from $CLI\"; fi\n    54\tdone\n    55\tif [ -x \"$GUI/bin/orca-ide-app\" ] && [ ! -e \"$GUI/bin/orca-ide\" ]; then\n    56\t  pass \"the GUI is orca-ide-app and leaves orca-ide to the CLI\"\n    57\telse fail \"GUI bin names\" \"$(ls \"$GUI/bin\" | paste -sd' ')\"; fi\n    58\t\n    59\t# Run from an Orca terminal, this test is already inside the GUI's FHS env, so\n    60\t# a bare wrapper exec'ing the Electron binary would pass every case below.\n    61\t# Hold the launcher itself to being a bwrap one.\n    62\tcli_bwrap=$(readlink -f \"$CLI/bin/.orca-ide-bwrap\")\n    63\tif grep -qE '^exec \"\\$\\{cmd\\[@\\]\\}\"|/bin/bwrap' \"$cli_bwrap\"; then\n    64\t  pass \"the CLI runs in its own bwrap FHS env\"\n    65\telse fail \"CLI launcher\" \"$cli_bwrap does not exec bwrap\"; fi\n    66\t\n    67\t# `orca open` spawns the app; without ORCA_APP_EXECUTABLE that is the raw\n    68\t# Electron in the CLI's env, with no wayland flag, fonts or nixGL.\n    69\tapp=$(grep -o -- '--setenv ORCA_APP_EXECUTABLE [^ ]*' \"$cli_bwrap\" | awk '{print $3}')\n    70\t# Exactly the profile's GUI: the unwrapped one has an orca-ide-app too, minus nixGL.\n    71\tif [ \"$app\" = \"$GUI/bin/orca-ide-app\" ]; then\n    72\t  pass \"orca open launches the profile's nixGL-wrapped GUI\"\n    73\telse fail \"ORCA_APP_EXECUTABLE\" \"'${app:-unset}', want $GUI/bin/orca-ide-app\"; fi\n    74\t\n    75\t# `orca-ide serve` probes that same executable in node mode, with a script as\n    76\t# argv; Node rejects --ozone-platform, so the wrapper must leave it off there.\n    77\t# Print, not exit status: if the env var were lost on the way, this would be a\n    78\t# GUI launch, which a running Orca's single-instance lock answers with 0.\n    79\tout=$(ELECTRON_RUN_AS_NODE=1 timeout 60 \"$GUI/bin/orca-ide-app\" -p '\"node-ok\"' 2>\"$T/node-err\")\n    80\tif [ \"$out\" = node-ok ]; then\n    81\t  pass \"orca-ide-app runs in node mode (serve's runtime probe)\"\n    82\telse fail \"orca-ide-app node mode\" \"${out:-$(tail -1 \"$T/node-err\")}\"; fi\n    83\t\n    84\t# Stopping `orca-ide serve` (systemctl, its own supervisor, a plain kill)\n    85\t# signals the outermost pid, and bwrap forwards nothing: without a forwarding\n    86\t# launcher a TERM kills bwrap and the process inside keeps the profile lock.\n    87\t# Node mode stands in for the GUI here: same launcher, and it can report what\n    88\t# it saw. Each payload exits on its own after 20s, so a regression cannot leak\n    89\t# it. Started under job control (set -m; bash's own, since CI has no\n    90\t# util-linux setsid): its own process group ($w), so a signal can go to the\n    91\t# whole group, never a terminal's foreground group however the suite is run,\n    92\t# and no SIGINT ignored, as bash otherwise does to a background job.\n    93\tpayload_start() { # payload_start <out-file>: node-mode GUI launch reporting TERM/INT/HUP\n    94\t  set -m\n    95\t  ELECTRON_RUN_AS_NODE=1 \"$GUI/bin/orca-ide-app\" -e '\n    96\t    for (const s of [\"SIGTERM\", \"SIGINT\", \"SIGHUP\"])\n    97\t      process.on(s, () => { console.log(\"got-\" + s); process.exit(0); });\n    98\t    console.log(\"ready\"); setTimeout(() => process.exit(3), 20000);' >\"$1\" 2>&1 &\n    99\t  w=$!\n   100\t  set +m\n   101\t}\n   102\tpayload() { # payload <out-file>: payload_start, then wait for it to be ready\n   103\t  payload_start \"$1\"\n   104\t  for _ in $(seq 150); do grep -q ready \"$1\" && break; sleep 0.2; done\n   105\t}\n   106\t\n   107\tpayload \"$T/term\"\n   108\t# While it runs: bwrap ignores HUP, INT and TERM. Ctrl-C, a terminal hangup\n   109\t# or a KillMode=control-group stop reaches the whole group, and a bwrap that\n   110\t# died of one would SIGKILL the payload (--die-with-parent) before its own\n   111\t# handler finished.\n   112\tbw=$(cat /proc/\"$w\"/task/*/children 2>/dev/null | awk '{print $1}')\n   113\tign=$(awk '/^SigIgn:/ {print $2}' /proc/\"$bw\"/status 2>/dev/null)\n   114\tmask=$(( (1 << 0) | (1 << 1) | (1 << 14) ))  # HUP, INT, TERM\n   115\tif [ -n \"$ign\" ] && [ $(( 0x$ign & mask )) -eq \"$mask\" ]; then pass \"the launcher's bwrap ignores HUP, INT and TERM\"\n   116\telse fail \"bwrap signals\" \"bwrap ($bw) SigIgn=${ign:-unreadable}\"; fi\n   117\tkill -TERM \"$w\" 2>/dev/null; wait \"$w\"; rc=$?\n   118\tif grep -q got-SIGTERM \"$T/term\" && [ \"$rc\" -eq 0 ]; then\n   119\t  pass \"TERM to the GUI launcher reaches the process in the sandbox\"\n   120\telse fail \"TERM forwarding\" \"rc=$rc, saw: $(tr '\\n' ' ' < \"$T/term\")\"; fi\n   121\t\n   122\t# The serve supervisor forwards SIGINT to its child too; off a terminal the\n   123\t# launcher must pass it on, not swallow it.\n   124\tpayload \"$T/int\"\n   125\tkill -INT \"$w\" 2>/dev/null; wait \"$w\"; rc=$?\n   126\tif grep -q got-SIGINT \"$T/int\" && [ \"$rc\" -eq 0 ]; then\n   127\t  pass \"INT to the GUI launcher (no terminal) reaches the process in the sandbox\"\n   128\telse fail \"INT forwarding\" \"rc=$rc, saw: $(tr '\\n' ' ' < \"$T/int\")\"; fi\n   129\t\n   130\t# TERM to the whole group (a control-group stop; a terminal hangup is the\n   131\t# same with HUP) reaches\n   132\t# bwrap too; it must survive to let the payload's handler run.\n   133\tpayload \"$T/group\"\n   134\tkill -TERM -- -\"$w\" 2>/dev/null; wait \"$w\"; rc=$?\n   135\tif grep -q got-SIGTERM \"$T/group\" && [ \"$rc\" -eq 0 ]; then\n   136\t  pass \"TERM to the launcher's whole group lets the payload handle it\"\n   137\telse fail \"group TERM\" \"rc=$rc, saw: $(tr '\\n' ' ' < \"$T/group\")\"; fi\n   138\t\n   139\t# A TERM during startup, while the layers before Node still have it ignored\n   140\t# (bwrap's dispositions are inherited until Node resets them), must not be\n   141\t# dropped: the launcher has to end, by the handler or by the default action.\n   142\tpayload_start \"$T/early\"\n   143\tsleep 0.05; kill -TERM \"$w\" 2>/dev/null\n   144\tfor _ in $(seq 50); do kill -0 \"$w\" 2>/dev/null || break; sleep 0.2; done\n   145\tif kill -0 \"$w\" 2>/dev/null; then\n   146\t  fail \"early TERM\" \"launcher still running 10s after a TERM at startup\"\n   147\t  kill -KILL \"$w\" 2>/dev/null\n   148\telse pass \"a TERM during startup still stops the launcher\"; fi\n   149\twait \"$w\" 2>/dev/null\n   150\t\n   151\t# Only HUP/INT/TERM deaths are re-raised: a plain exit above 128 is a status,\n   152\t# and re-raising 148 (TSTP) would stop the launcher instead of exiting it.\n   153\tELECTRON_RUN_AS_NODE=1 timeout 60 \"$GUI/bin/orca-ide-app\" -e 'process.exit(148)' >/dev/null 2>&1; rc=$?\n   154\tif [ \"$rc\" -eq 148 ]; then pass \"a plain exit 148 comes back as 148\"\n   155\telse fail \"exit status\" \"exit 148 came back as $rc\"; fi\n   156\t\n   157\t# Ctrl-C itself, on a real pty: the payload sees exactly one SIGINT and gets\n   158\t# to handle it. Needs python3 for the pty, which CI's tool shell lacks.\n   159\tif command -v python3 >/dev/null; then\n   160\t  got=$(timeout 60 python3 -I - \"$GUI/bin/orca-ide-app\" <<'EOF'\n   161\timport os, pty, re, select, sys, time\n   162\tpid, fd = pty.fork()\n   163\tif pid == 0:\n   164\t    os.environ[\"ELECTRON_RUN_AS_NODE\"] = \"1\"\n   165\t    os.execv(sys.argv[1], [sys.argv[1], \"-e\",\n   166\t        'let n = 0; process.on(\"SIGINT\", () => { n++; setTimeout(() => {'\n   167\t        ' console.log(\"ints=\" + n); process.exit(0); }, 1500); });'\n   168\t        ' console.log(\"ready\"); setTimeout(() => process.exit(3), 20000);'])\n   169\tbuf = b\"\"\n   170\tdef read_until(s, secs):\n   171\t    global buf\n   172\t    t = time.time()\n   173\t    while s not in buf and time.time() - t < secs:\n   174\t        try:\n   175\t            if select.select([fd], [], [], 0.5)[0]: buf += os.read(fd, 1024)\n   176\t        except OSError: break\n   177\tread_until(b\"ready\", 30); os.write(fd, b\"\\x03\"); read_until(b\"ints=\", 10)\n   178\tm = re.findall(r\"ints=\\d+\", buf.decode(errors=\"replace\"))  # the echoed ^C precedes it\n   179\tprint(m[-1] if m else \"none\", os.waitpid(pid, 0)[1])\n   180\tEOF\n   181\t)\n   182\t  if [ \"$got\" = \"ints=1 0\" ]; then pass \"Ctrl-C on a pty reaches the payload once, and it exits cleanly\"\n   183\t  else fail \"Ctrl-C\" \"got $got (want ints=1, status 0)\"; fi\n   184\telse\n   185\t  echo \"skip Ctrl-C on a pty: no python3\"\n   186\tfi\n   187\t\n   188\t# A background job's stdin is /dev/null unless the launcher says otherwise,\n   189\t# and the CLI reads stdin.\n   190\tgot=$(echo stdin-ok | ELECTRON_RUN_AS_NODE=1 timeout 60 \"$GUI/bin/orca-ide-app\" -e 'process.stdin.pipe(process.stdout)' 2>&1)\n   191\tif [ \"$got\" = stdin-ok ]; then pass \"the launcher passes stdin through\"\n   192\telse fail \"stdin\" \"got '$got'\"; fi\n   193\t\n   194\t# The CLI uses the same launcher (it is what systemctl stops for a service\n   195\t# `orca-ide serve`), wrapping its own bwrap.\n   196\tif grep -q 'forward-signals' \"$CLI/bin/orca-ide\" 2>/dev/null \\\n   197\t   && grep -q '\\.orca-ide-bwrap' \"$CLI/bin/orca-ide\"; then\n   198\t  pass \"the CLI forwards signals into its sandbox too\"\n   199\telse fail \"CLI launcher\" \"$CLI/bin/orca-ide is not the forwarding launcher\"; fi\n   200\t\n   201\t# `orca-ide open` spawns the GUI detached and returns. The launcher shell\n   202\t# outlives that parent, and the GUI's bwrap is the launcher's child, so\n   203\t# --die-with-parent stays on: it is what takes the GUI down if the launcher\n   204\t# is SIGKILLed (the serve supervisor's last resort) instead of orphaning it.\n   205\tgui_launcher=$(readlink -f \"$GUI/bin/.orca-ide-unwrapped\")\n   206\tif grep -q '/bin/bwrap' \"$gui_launcher\" 2>/dev/null && grep -q -- '--die-with-parent' \"$gui_launcher\"; then\n   207\t  pass \"the GUI's bwrap dies with its launcher\"\n   208\telse fail \"GUI launcher\" \"$gui_launcher lacks --die-with-parent (or is missing)\"; fi\n   209\t# And the payload outlives a parent that spawns it detached and exits.\n   210\tbash -c 'ELECTRON_RUN_AS_NODE=1 \"$1\" -e \"\n   211\t  setTimeout(() => require(\\\"fs\\\").writeFileSync(process.argv[1], \\\"alive\\\"), 3000);\n   212\t  setTimeout(() => process.exit(0), 4000);\" \"$2\" >/dev/null 2>&1 &' _ \"$GUI/bin/orca-ide-app\" \"$T/alive\"\n   213\tfor _ in $(seq 75); do [ -s \"$T/alive\" ] && break; sleep 0.2; done\n   214\tif [ -s \"$T/alive\" ]; then pass \"the GUI outlives the parent that spawned it (orca-ide open)\"\n   215\telse fail \"GUI lifetime\" \"payload died with its spawning parent\"; fi\n   216\t\n   217\t# The manifest travels with the extracted AppImage, which the CLI's runScript\n   218\t# references, so it is in the CLI's closure.\n   219\tcontents=$(nix-store -qR \"$CLI\" | while read -r p; do\n   220\t  [ -f \"$p/resources/skills/current-manifest.json\" ] && echo \"$p\"; done | head -1)\n   221\t[ -n \"$contents\" ] || { echo \"no extracted AppImage in the closure of $CLI\" >&2; exit 1; }\n   222\tmanifest=\"$contents/resources/skills/current-manifest.json\"\n   223\t\n   224\t# Outside an Orca terminal: none of its env, none of its shim dir on PATH.\n   225\tclean_path=$(printf '%s' \"$PATH\" | tr ':' '\\n' | grep -v 'linux-orca-cli-shim' | paste -sd:)\n   226\toutside() { env $(compgen -e | grep '^ORCA_' | sed 's/^/-u /') PATH=\"$clean_path\" \"$@\"; }\n   227\t\n   228\tgot=$(outside \"$CLI/bin/orca\" --version 2>&1)\n   229\tif printf '%s' \"$got\" | grep -qwF \"$want_version\"; then pass \"orca --version reports $want_version outside Orca\"\n   230\telse fail \"orca --version\" \"got '$got', want $want_version\"; fi\n   231\t\n   232\t# What every skill stub runs, under both names the stubs choose between.\n   233\tfor b in orca-ide orca; do\n   234\t  got=$(outside \"$CLI/bin/$b\" skills get orca-cli 2>&1)\n   235\t  if printf '%s' \"$got\" | grep -q '^# Orca CLI'; then pass \"$b skills get orca-cli prints the guide outside Orca\"\n   236\t  else fail \"$b skills get\" \"$(printf '%s' \"$got\" | head -3)\"; fi\n   237\tdone\n   238\t\n   239\t# The rev is pinned by hand next to the version; the app knows its own.\n   240\trev=$(nix eval --raw \"$HM.home.file\" --apply 'f: f.\".claude/skills/orca-cli\".source' | sed -nE 's|.*-orca-skills-([0-9a-f]{40})/.*|\\1|p')\n   241\tif [ -n \"$rev\" ] && grep -aqF \"sourceCommit:\\`$rev\\`\" \"$contents/resources/app.asar\"; then\n   242\t  pass \"skills rev ${rev:0:8} is this build's sourceCommit\"\n   243\telse fail \"skills rev\" \"'${rev:-unparsed}' is not the sourceCommit in app.asar\"; fi\n   244\t\n   245\tfor s in $SKILLS; do\n   246\t  src=$(nix eval --raw \"$HM.home.file\" --apply \"f: toString f.\\\".claude/skills/$s\\\".source\" 2>/dev/null) \\\n   247\t    || { fail \"$s\" \"no home.file .claude/skills/$s\"; continue; }\n   248\t  # The source is a subpath of a fetch; realise the fetch's derivation itself.\n   249\t  srcdrv=$(nix eval --raw \"$HM.home.file\" --apply \\\n   250\t    \"f: builtins.head (builtins.attrNames (builtins.getContext f.\\\".claude/skills/$s\\\".source))\" 2>/dev/null)\n   251\t  nix-store --realise \"$srcdrv\" >/dev/null\n   252\t  # Every file the manifest lists for the skill, as \"<sha256>  <path>\" lines.\n   253\t  want=$(jq -r --arg n \"$s\" '.skills[] | select(.name == $n) | .files[] | \"\\(.exactSha256)  \\(.path)\"' \"$manifest\")\n   254\t  [ -n \"$want\" ] || { fail \"$s\" \"no entry in the manifest\"; continue; }\n   255\t  if out=$(cd \"$src\" 2>/dev/null && printf '%s\\n' \"$want\" | sha256sum --quiet -c - 2>&1); then\n   256\t    pass \"$s matches this build's manifest ($(printf '%s\\n' \"$want\" | wc -l) files)\"\n   257\t  else fail \"$s\" \"${out:-$src is missing}\"; fi\n   258\tdone\n   259\t\n   260\tprintf '\\n%d/%d passed\\n' \"$((n-fails))\" \"$n\"\n   261\t[ \"$fails\" -eq 0 ]\n# Ad-hoc evaluation and test runs on the in-cluster runner, so a \"does this\n# still evaluate?\" check costs nothing on the laptop.\n#\n# Driven by `hmeval --ci` (home.nix), which commits the working tree — dirty or\n# not — to an `eval/**` branch and reads the result back out of this job's log.\n# The branch is throwaway and `hmeval` deletes it afterwards.\n#\n# This does NOT push to attic. nix-home.yml owns the closure cache; this job\n# only answers a question, so a scratch eval cannot poison the cache with paths\n# built from a commit that never reached master.\nname: nix-eval\n\non:\n  push:\n    branches: [\"eval/**\"]\n  workflow_dispatch:\n\n# Unlike nix-home.yml, this one cancels. A closure build that gets discarded\n# wastes twenty minutes of work someone is waiting on; a superseded eval is\n# just a stale answer, and `hmeval` is already watching the newer run.\nconcurrency:\n  group: nix-eval-${{ github.ref }}\n  cancel-in-progress: true\n\njobs:\n  eval:\n    # Same runner and image as nix-home.yml, for the same reasons — see\n    # docs/ci-nix-home.md before changing either. In particular: no `uses:`\n    # steps (the image has no node), and no awk/sed/grep, which is why the\n    # request file below is parsed in pure bash.\n    runs-on: privileged\n    container:\n      image: nixos/nix@sha256:1a711b619c8a713eff32c3f8d8781b3b4d0130cb91c0a57f67e87abfeeb90b01\n    env:\n      NIX_CONFIG: |\n        experimental-features = nix-command flakes\n        netrc-file = /root/.config/nix/netrc\n        extra-substituters = http://attic.attic.svc.cluster.local/kube\n        extra-trusted-public-keys = kube:REDACTED\n        max-jobs = 6\n        cores = 4\n        sandbox = true\n      # Pinned the same way nix-home.yml pins its attic-client: the image ships\n      # no coreutils/grep/jq, and the test scripts in tests/ assume a normal\n      # userland. One rev for both, so a bump moves them together.\n      TOOLS_REV: 29916453413845e54a65b8a1cf996842300cd299\n      # Which host tests/ should believe it is running on; see the tests branch\n      # below. Any host with a full desktop config will do.\n      TEST_HOST: utsuho\n    steps:\n      - name: authorise nix against attic\n        env:\n          ATTIC_TOKEN: ${{ secrets.ATTIC_TOKEN }}\n        run: |\n          set -eu\n          mkdir -p /root/.config/nix\n          umask 077\n          printf 'machine %s password %s\\n' \\\n            attic.attic.svc.cluster.local \"$ATTIC_TOKEN\" \\\n            > /root/.config/nix/netrc\n          printf 'machine %s password %s\\n' \\\n            attic.ko.ag \"$ATTIC_TOKEN\" \\\n            >> /root/.config/nix/netrc\n\n      - name: checkout\n        run: |\n          set -eu\n          git clone https://forge.ko.ag/${{ github.repository }}.git .\n          git checkout --detach ${{ github.sha }}\n          git --no-pager log -1 --oneline\n\n      # Do NOT echo $FORGE_TOKEN or enable `set -x` here.\n      - name: authorise git against the private input\n        env:\n          FORGE_TOKEN: ${{ secrets.FORGE_TOKEN }}\n        run: |\n          set -eu\n          git config --global credential.\"https://forge.ko.ag\".username oauth2\n          git config --global credential.\"https://forge.ko.ag\".helper \\\n            '!f() { test \"$1\" = get && printf \"password=%s\\n\" \"$FORGE_TOKEN\"; }; f'\n\n      # The whole contract with `hmeval` is this file plus the two markers\n      # below. Keep them in step: hmeval slices the job log between them, so a\n      # renamed marker silently turns every run into \"no output\".\n      - name: run the request\n        env:\n          # Load-bearing, and not obviously so. The credential helper configured\n          # in the previous step answers out of $FORGE_TOKEN *at the moment nix\n          # shells out to git*, which is here — so a helper installed globally\n          # but an env set only on the earlier step leaves this one answering\n          # with an empty password. The failure is not an auth error either; it\n          # surfaces as `error: Failed to fetch git repository\n          # 'https://forge.ko.ag/sauyon/dotfiles-private.git'` partway down a\n          # stack trace about home.activation, which reads like a broken config.\n          # nix-home.yml sets it on its build step for exactly this reason.\n          FORGE_TOKEN: ${{ secrets.FORGE_TOKEN }}\n        run: |\n          set -eu\n\n          req=.hmeval-request\n          if [ ! -f \"$req\" ]; then\n            echo \"no $req in this commit — nothing to run.\"\n            echo \"This workflow is driven by \\`hmeval --ci\\`; pushing an eval/**\"\n            echo \"branch by hand does not carry a request.\"\n            exit 1\n          fi\n\n          # Pure bash: no awk/sed/grep in this image. Values are single-line by\n          # construction (hmeval rejects newlines before it writes the file).\n          mode=; hosts=; tests=; attr=\n          while IFS='=' read -r k v; do\n            case \"$k\" in\n              mode)  mode=$v ;;\n              hosts) hosts=$v ;;\n              tests) tests=$v ;;\n              attr)  attr=$v ;;\n            esac\n          done < \"$req\"\n\n          echo \"hmeval: mode=$mode\"\n          echo \"---8<--- hmeval\"\n          rc=0\n\n          # $hosts and $tests are unquoted in the loops below ON PURPOSE: they\n          # are space-separated lists and the word splitting is the mechanism.\n          # Quoting them turns the whole list into one argument, which fails as\n          # \"attribute 'utsuho fujiwara ...' missing\" rather than as a syntax\n          # error, so it looks like a broken flake instead of a broken quote.\n          # hmeval guarantees they contain no other whitespace.\n\n          case \"$mode\" in\n            eval)\n              # --no-link/--raw keeps this to evaluation plus whatever IFD the\n              # config genuinely needs; nothing is pushed anywhere.\n              for h in $hosts; do\n                if out=$(nix eval --raw \".#homeConfigurations.$h.activationPackage.drvPath\"); then\n                  printf '  %-10s %s\\n' \"$h\" \"$out\"\n                else\n                  printf '  %-10s FAILED\\n' \"$h\"\n                  rc=1\n                fi\n              done\n              ;;\n            attr)\n              if out=$(nix eval --raw \".#$attr\"); then\n                printf '  %s\\n' \"$out\"\n              else\n                printf '  FAILED: .#%s\\n' \"$attr\"\n                rc=1\n              fi\n              ;;\n            tests)\n              # Several scripts in tests/ build the thing they test by way of\n              # `homeConfigurations.$(cat /etc/hostname)` — fine on a box that\n              # is one of the hosts, useless in a container whose hostname is\n              # its own ID. Run 137 died twice over with\n              #\n              #   does not provide attribute\n              #   'homeConfigurations.328998cea6c4.config.home.packages'\n              #\n              # Rather than teach eight scripts a new seam, tell the ephemeral\n              # container it is a host. It only ever needs to be *a* host whose\n              # config contains the script under test; utsuho has all of them.\n              printf '%s' \"$TEST_HOST\" > /etc/hostname\n              echo \"  (as $TEST_HOST)\"\n\n              # tests/*.sh are ordinary shell: they want coreutils, grep, sed\n              # and jq, none of which the nix image has. Run them inside a\n              # pinned shell rather than teaching each script to cope.\n              tools=\"github:NixOS/nixpkgs/$TOOLS_REV\"\n              for t in $tests; do\n                echo \"  === $t\"\n                if nix shell \\\n                     \"$tools#bash\" \"$tools#coreutils\" \"$tools#gnugrep\" \\\n                     \"$tools#gnused\" \"$tools#gawk\" \"$tools#git\" \\\n                     \"$tools#jq\" \"$tools#diffutils\" \\\n                     -c bash \"$t\"; then\n                  echo \"  === $t PASSED\"\n                else\n                  echo \"  === $t FAILED\"\n                  rc=1\n                fi\n              done\n              ;;\n            *)\n              echo \"  unknown mode: $mode\"\n              rc=1\n              ;;\n          esac\n\n          echo \"---8<--- end\"\n          exit $rc\ndiff --git a/tests/sandbox-fonts.sh b/tests/sandbox-fonts.sh\nindex 8061ca50..7ed64b4a 100755\n--- a/tests/sandbox-fonts.sh\n+++ b/tests/sandbox-fonts.sh\n@@ -22,7 +22,7 @@\n # Usage:\n #   tests/sandbox-fonts.sh               build this host's orca and test it\n #   tests/sandbox-fonts.sh <orca-path>   test a given build, e.g. the live one:\n-#                                        $(dirname $(dirname $(readlink -f ~/.nix-profile/bin/orca-ide)))\n+#                                        $(dirname $(dirname $(readlink -f ~/.nix-profile/bin/orca-ide-app)))\n \n set -u\n set -o pipefail\n@@ -34,7 +34,7 @@ fail() { n=$((n+1)); echo \"FAIL $1: $2\"; fails=$((fails+1)); }\n ORCA=\"${1:-}\"\n if [ -z \"$ORCA\" ]; then\n   FLAKE=$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/..\" && pwd)\n-  drv=$(nix eval --raw \"$FLAKE#homeConfigurations.$(cat /etc/hostname).config.home.packages\" \\\n+  drv=$(nix eval --raw \"$FLAKE#homeConfigurations.$(cat /etc/hostname 2>/dev/null || uname -n).config.home.packages\" \\\n     --apply 'ps: (builtins.head (builtins.filter (p: builtins.match \".*orca-[0-9.]+\" (p.name or \"\") != null) ps)).drvPath') \\\n     || { echo \"orca is not in home.packages here\" >&2; exit 1; }\n   ORCA=$(nix-store --realise \"$drv\" | tail -1) || { echo \"could not build orca\" >&2; exit 1; }","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"0946f035-9877-4741-b57e-d438df98254b","context":{"git_state":{"cwd":"/home/sauyon/devel/dotfiles/.drovr/wt/orca-cli-skills","root":"/home/sauyon/devel/dotfiles/.drovr/wt/orca-cli-skills","branch":"orca-cli-skills","default_branch":null,"status":{"clean":true,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"forge.ko.ag","remote":"sauyon/dotfiles","visibility":"unknown"},"push_remote":"origin","remotes":[{"name":"origin","host":"forge.ko.ag","remote":"sauyon/dotfiles","visibility":"unknown"}],"visibility_cache":[{"host":"forge.ko.ag","remote":"sauyon/dotfiles","visibility":"unknown"}]}},"live_cwd":"/home/sauyon/devel/dotfiles/.drovr/wt/orca-cli-skills","platform":"linux"}},"sandboxed":false,"sourceToolAssistantUUID":"478763e5-b3e2-43cc-b92f-db8d53573361","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"userType":"external","entrypoint":"cli","cwd":"/home/sauyon/devel/dotfiles/.drovr/wt/orca-cli-skills","sessionId":"d19ff9ff-38c8-4378-ac54-4f4061f74300","version":"2.1.308","gitBranch":"orca-cli-skills"}
{"parentUuid":"19673fc0-9f89-4828-adb5-036cd44f7ae9","isSidechain":true,"agentId":"a0b3aefd808268adb","attachment":{"type":"nested_memory","path":"/home/sauyon/devel/dotfiles/.drovr/wt/orca-cli-skills/CLAUDE.md","content":{"path":"/home/sauyon/devel/dotfiles/.drovr/wt/orca-cli-skills/CLAUDE.md","type":"Project","content":"## NO EMAILS\n\n**Never write an email address into anything.** Not into files, commit messages,\ndocs, notes, handoffs or scratch files — mine, colleagues', or service accounts.\nThis repo is public, and an address is a durable identifier that spreads: it\nleaks the work/personal boundary, it enumerates people, and once written it gets\ncopied onward.\n\nRefer to an account by its **role** — \"the personal Google account\", \"the work\naccount\", \"the project's GCS service agent\" — or record the command that\nrecovers the identity at read time (`gcloud config get-value account`) rather\nthan pasting its output. Role-based wording is better documentation anyway: \"must\nbe the personal account, not the work one\" survives an address change; a pasted\naddress does not.\n\nIf an address seems genuinely load-bearing, ask first.\n\nThe exception is the git identity already configured in `home.nix`, which git\nrequires and which is on every commit regardless.\n\n## Commit and Push Policy\n\nThis is a personal dotfiles repo on `master`. When asked to commit and push, do both without asking for confirmation. The global \"ask before public communications\" rule does not apply here.\n\n## Applying config: use `hms`, not `home-manager switch`\n\n`hms` (defined in `home.nix`, documented in `README.md`) pushes, waits for the\ncommit's CI run on `forge.ko.ag`, then switches — so the switch is a download of\nthe closure the in-cluster runner built, not a local compile. Expect it to block\nfor ten-odd minutes. `hms --local` builds here instead.\n\nIt refuses on a dirty tree and on a diverged checkout — **both refusals are\nthe feature.** CI can only build a pushed commit, so do not route around them\nwith a bare `home-manager switch` — commit and push, or pass `--local`\ndeliberately and say that you did.\n\nA checkout on master that is strictly behind `origin/master` fast-forwards to\nthe fetched SHA and continues — no refusal, nothing to decide.\n\nIf a run goes red, `hms` prints the job's `error:` lines; read those rather than\nre-running blind. Background on why CI is worth waiting for — and the 600s attic\ntransfer ceiling that made it unreliable for its first 61 runs — is in\n`docs/ci-nix-home.md`.\n","contentDiffersFromDisk":false},"displayPath":"CLAUDE.md"},"type":"attachment","uuid":"abcbaeca-8e92-43c8-bdda-56885867bb34","timestamp":"2026-10-24T12:29:31.140Z","rendered":[{"content":"<system-reminder>\nContents of /home/sauyon/devel/dotfiles/.drovr/wt/orca-cli-skills/CLAUDE.md:\n\n## NO EMAILS\n\n**Never write an email address into anything.** Not into files, commit messages,\ndocs, notes, handoffs or scratch files — mine, colleagues', or service accounts.\nThis repo is public, and an address is a durable identifier that spreads: it\nleaks the work/personal boundary, it enumerates people, and once written it gets\ncopied onward.\n\nRefer to an account by its **role** — \"the personal Google account\", \"the work\naccount\", \"the project's GCS service agent\" — or record the command that\nrecovers the identity at read time (`gcloud config get-value account`) rather\nthan pasting its output. Role-based wording is better documentation anyway: \"must\nbe the personal account, not the work one\" survives an address change; a pasted\naddress does not.\n\nIf an address seems genuinely load-bearing, ask first.\n\nThe exception is the git identity already configured in `home.nix`, which git\nrequires and which is on every commit regardless.\n\n## Commit and Push Policy\n\nThis is a personal dotfiles repo on `master`. When asked to commit and push, do both without asking for confirmation. The global \"ask before public communications\" rule does not apply here.\n\n## Applying config: use `hms`, not `home-manager switch`\n\n`hms` (defined in `home.nix`, documented in `README.md`) pushes, waits for the\ncommit's CI run on `forge.ko.ag`, then switches — so the switch is a download of\nthe closure the in-cluster runner built, not a local compile. Expect it to block\nfor ten-odd minutes. `hms --local` builds here instead.\n\nIt refuses on a dirty tree and on a diverged checkout — **both refusals are\nthe feature.** CI can only build a pushed commit, so do not route around them\nwith a bare `home-manager switch` — commit and push, or pass `--local`\ndeliberately and say that you did.\n\nA checkout on master that is strictly behind `origin/master` fast-forwards to\nthe fetched SHA and continues — no refusal, nothing to decide.\n\nIf a run goes red, `hms` prints the job's `error:` lines; read those rather than\nre-running blind. Background on why CI is worth waiting for — and the 600s attic\ntransfer ceiling that made it unreliable for its first 61 runs — is in\n`docs/ci-nix-home.md`.\n\n</system-reminder>"}],"renderedRole":"user","userType":"external","entrypoint":"cli","cwd":"/home/sauyon/devel/dotfiles/.drovr/wt/orca-cli-skills","sessionId":"d19ff9ff-38c8-4378-ac54-4f4061f74300","version":"2.1.308","gitBranch":"orca-cli-skills"}
