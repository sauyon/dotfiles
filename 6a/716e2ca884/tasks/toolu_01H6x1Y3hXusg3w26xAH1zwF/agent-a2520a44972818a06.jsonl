{"parentUuid":"2e296051-f1f8-4b3b-8e6f-a6b5a7231521","isSidechain":true,"promptId":"0130a666-0620-4dc6-a158-7fc732cfba9c","agentId":"a2520a44972818a06","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FxVomTQNb3kbGV7QYXXWUB","type":"tool_result","content":"     1\t#!/usr/bin/env bash\n     2\t# Cases for the claims orca.nix makes about the Orca CLI and its agent skills:\n     3\t# that `orca-ide` and `orca` are the CLI and run from any shell, not only an\n     4\t# Orca terminal, and that the skills in ~/.claude/skills are the bytes this\n     5\t# Orca build expects.\n     6\t#\n     7\t# Why this needs a test. Orca's own installer only reaches an Orca terminal: it\n     8\t# puts a shim dir on PATH there (ORCA_CLI_BIN_DIR) and symlinks\n     9\t# ~/.local/bin/orca-ide at a raw /nix/store path, a script that runs Electron\n    10\t# against the host's libraries outside the FHS env. The skills are stubs\n    11\t# that tell the agent to run `orca-ide skills get <name>`, so a skill without a\n    12\t# working CLI is a dead end. And the skills are pinned to a commit separately\n    13\t# from the AppImage version; bumping one without the other silently installs\n    14\t# guides for a different CLI. Orca ships the expected hashes in\n    15\t# resources/skills/current-manifest.json, so that is what the files are held to.\n    16\t#\n    17\t# Usage:\n    18\t#   tests/orca-cli-skills.sh    eval + build this host's config and test it\n    19\t\n    20\tset -u\n    21\tset -o pipefail\n    22\t\n    23\tfails=0; n=0\n    24\tpass() { n=$((n+1)); echo \"ok   $1\"; }\n    25\tfail() { n=$((n+1)); echo \"FAIL $1: $2\"; fails=$((fails+1)); }\n    26\tT=$(mktemp -d); trap 'rm -rf \"$T\"' EXIT\n    27\t\n    28\tFLAKE=$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/..\" && pwd)\n    29\t# /etc/hostname is what CI writes to say which host it is; Orca's sandbox does\n    30\t# not bind it in, so fall back to uname -n there.\n    31\tHM=\"$FLAKE#homeConfigurations.$(cat /etc/hostname 2>/dev/null || uname -n).config\"\n    32\tSKILLS=\"orca-cli orchestration computer-use orca-per-workspace-env orca-linear linear-tickets\"\n    33\t\n    34\tpkg_attr() { # pkg_attr <pname> <attr>\n    35\t  nix eval --raw \"$HM.home.packages\" \\\n    36\t    --apply \"ps: (builtins.head (builtins.filter (p: (p.pname or \\\"\\\") == \\\"$1\\\") ps)).$2\"\n    37\t}\n    38\tdrv=$(pkg_attr orca-cli drvPath) || { echo \"no orca-cli in home.packages here\" >&2; exit 1; }\n    39\twant_version=$(pkg_attr orca-cli version) && [ -n \"$want_version\" ] \\\n    40\t  || { echo \"orca-cli has no version\" >&2; exit 1; }\n    41\tCLI=$(nix-store --realise \"$drv\" | tail -1) || { echo \"could not build orca-cli\" >&2; exit 1; }\n    42\tgui_drv=$(pkg_attr orca drvPath) || { echo \"no orca in home.packages here\" >&2; exit 1; }\n    43\tGUI=$(nix-store --realise \"$gui_drv\" | tail -1) || { echo \"could not build orca\" >&2; exit 1; }\n    44\techo \"testing $CLI and $GUI\"\n    45\t\n    46\t# The skills' own rule: outside an Orca terminal, on Linux, the CLI is\n    47\t# `orca-ide`; elsewhere it is `orca`. Both names must be the CLI, and the GUI\n    48\t# must not also claim `orca-ide` -- in the profile it would shadow one of them.\n    49\tfor b in orca orca-ide; do\n    50\t  if [ -x \"$CLI/bin/$b\" ]; then pass \"orca-cli provides bin/$b\"\n    51\t  else fail \"bin/$b\" \"missing from $CLI\"; fi\n    52\tdone\n    53\tif [ -x \"$GUI/bin/orca-ide-app\" ] && [ ! -e \"$GUI/bin/orca-ide\" ]; then\n    54\t  pass \"the GUI is orca-ide-app and leaves orca-ide to the CLI\"\n    55\telse fail \"GUI bin names\" \"$(ls \"$GUI/bin\" | paste -sd' ')\"; fi\n    56\t\n    57\t# Run from an Orca terminal, this test is already inside the GUI's FHS env, so\n    58\t# a bare wrapper exec'ing the Electron binary would pass every case below.\n    59\t# Hold the launcher itself to being a bwrap one.\n    60\tcli_bwrap=$(readlink -f \"$CLI/bin/.orca-ide-bwrap\")\n    61\tif grep -qE '^exec \"\\$\\{cmd\\[@\\]\\}\"|/bin/bwrap' \"$cli_bwrap\"; then\n    62\t  pass \"the CLI runs in its own bwrap FHS env\"\n    63\telse fail \"CLI launcher\" \"$cli_bwrap does not exec bwrap\"; fi\n    64\t\n    65\t# `orca open` spawns the app; without ORCA_APP_EXECUTABLE that is the raw\n    66\t# Electron in the CLI's env, with no wayland flag, fonts or nixGL.\n    67\tapp=$(grep -o -- '--setenv ORCA_APP_EXECUTABLE [^ ]*' \"$cli_bwrap\" | awk '{print $3}')\n    68\t# Exactly the profile's GUI: the unwrapped one has an orca-ide-app too, minus nixGL.\n    69\tif [ \"$app\" = \"$GUI/bin/orca-ide-app\" ]; then\n    70\t  pass \"orca open launches the profile's nixGL-wrapped GUI\"\n    71\telse fail \"ORCA_APP_EXECUTABLE\" \"'${app:-unset}', want $GUI/bin/orca-ide-app\"; fi\n    72\t\n    73\t# `orca-ide serve` probes that same executable in node mode, with a script as\n    74\t# argv; Node rejects --ozone-platform, so the wrapper must leave it off there.\n    75\t# Print, not exit status: if the env var were lost on the way, this would be a\n    76\t# GUI launch, which a running Orca's single-instance lock answers with 0.\n    77\tout=$(ELECTRON_RUN_AS_NODE=1 timeout 60 \"$GUI/bin/orca-ide-app\" -p '\"node-ok\"' 2>\"$T/node-err\")\n    78\tif [ \"$out\" = node-ok ]; then\n    79\t  pass \"orca-ide-app runs in node mode (serve's runtime probe)\"\n    80\telse fail \"orca-ide-app node mode\" \"${out:-$(tail -1 \"$T/node-err\")}\"; fi\n    81\t\n    82\t# Stopping `orca-ide serve` (systemctl, its own supervisor, a plain kill)\n    83\t# signals the outermost pid. bwrap neither forwards signals nor dies when\n    84\t# --die-with-parent is off, so without a forwarding launcher the TERM kills\n    85\t# bwrap and the process inside keeps the profile lock. Node mode stands in for\n    86\t# the GUI here: same launcher, and it can report what it saw. The script exits\n    87\t# on its own after 20s, so a regression cannot leak it.\n    88\tELECTRON_RUN_AS_NODE=1 \"$GUI/bin/orca-ide-app\" -e '\n    89\t  process.on(\"SIGTERM\", () => { console.log(\"got-term\"); process.exit(0); });\n    90\t  console.log(\"ready\"); setTimeout(() => process.exit(3), 20000);' >\"$T/term\" 2>&1 &\n    91\tw=$!\n    92\tfor _ in $(seq 150); do grep -q ready \"$T/term\" && break; sleep 0.2; done\n    93\tkill -TERM \"$w\" 2>/dev/null; wait \"$w\"; rc=$?\n    94\tif grep -q got-term \"$T/term\" && [ \"$rc\" -eq 0 ]; then\n    95\t  pass \"TERM to the GUI launcher reaches the process in the sandbox\"\n    96\telse fail \"signal forwarding\" \"rc=$rc, saw: $(tr '\\n' ' ' < \"$T/term\")\"; fi\n    97\t\n    98\t# The forwarding launcher backgrounds bwrap, which in a non-interactive shell\n    99\t# means stdin from /dev/null and SIGINT ignored -- the CLI reads stdin, and\n   100\t# Ctrl-C must still kill it. Run in the foreground here, so neither is the\n   101\t# test's own doing.\n   102\tgot=$(echo stdin-ok | ELECTRON_RUN_AS_NODE=1 \"$GUI/bin/orca-ide-app\" -e 'process.stdin.pipe(process.stdout)' 2>&1)\n   103\tif [ \"$got\" = stdin-ok ]; then pass \"the launcher passes stdin through\"\n   104\telse fail \"stdin\" \"got '$got'\"; fi\n   105\tign=$(ELECTRON_RUN_AS_NODE=1 \"$GUI/bin/orca-ide-app\" -p \\\n   106\t  'require(\"fs\").readFileSync(\"/proc/self/status\",\"utf8\").match(/SigIgn:\\s*(\\w+)/)[1]' 2>&1)\n   107\tif [ -n \"$ign\" ] && [ $(( 0x$ign & 2 )) -eq 0 ]; then pass \"SIGINT is not ignored inside the launcher\"\n   108\telse fail \"SIGINT\" \"SigIgn=$ign\"; fi\n   109\t\n   110\t# The CLI uses the same launcher (it is what systemctl stops for a service\n   111\t# `orca-ide serve`), wrapping its own bwrap.\n   112\tif grep -q 'forward-signals' \"$CLI/bin/orca-ide\" 2>/dev/null \\\n   113\t   && grep -q '\\.orca-ide-bwrap' \"$CLI/bin/orca-ide\"; then\n   114\t  pass \"the CLI forwards signals into its sandbox too\"\n   115\telse fail \"CLI launcher\" \"$CLI/bin/orca-ide is not the forwarding launcher\"; fi\n   116\t\n   117\t# `orca-ide open` spawns the GUI detached, but each wrapper layer execs the\n   118\t# next, so the GUI's bwrap is the CLI's direct child; with --die-with-parent\n   119\t# it is SIGKILLed the moment `open` returns.\n   120\tgui_launcher=$(readlink -f \"$GUI/bin/.orca-ide-unwrapped\")\n   121\tif grep -q '/bin/bwrap' \"$gui_launcher\" 2>/dev/null && ! grep -q -- '--die-with-parent' \"$gui_launcher\"; then\n   122\t  pass \"the GUI outlives the orca-ide open that started it\"\n   123\telse fail \"GUI launcher\" \"$gui_launcher passes --die-with-parent (or is missing)\"; fi\n   124\t\n   125\t# The manifest travels with the extracted AppImage, which the CLI's runScript\n   126\t# references, so it is in the CLI's closure.\n   127\tcontents=$(nix-store -qR \"$CLI\" | while read -r p; do\n   128\t  [ -f \"$p/resources/skills/current-manifest.json\" ] && echo \"$p\"; done | head -1)\n   129\t[ -n \"$contents\" ] || { echo \"no extracted AppImage in the closure of $CLI\" >&2; exit 1; }\n   130\tmanifest=\"$contents/resources/skills/current-manifest.json\"\n   131\t\n   132\t# Outside an Orca terminal: none of its env, none of its shim dir on PATH.\n   133\tclean_path=$(printf '%s' \"$PATH\" | tr ':' '\\n' | grep -v 'linux-orca-cli-shim' | paste -sd:)\n   134\toutside() { env $(compgen -e | grep '^ORCA_' | sed 's/^/-u /') PATH=\"$clean_path\" \"$@\"; }\n   135\t\n   136\tgot=$(outside \"$CLI/bin/orca\" --version 2>&1)\n   137\tif printf '%s' \"$got\" | grep -qwF \"$want_version\"; then pass \"orca --version reports $want_version outside Orca\"\n   138\telse fail \"orca --version\" \"got '$got', want $want_version\"; fi\n   139\t\n   140\t# What every skill stub runs, under both names the stubs choose between.\n   141\tfor b in orca-ide orca; do\n   142\t  got=$(outside \"$CLI/bin/$b\" skills get orca-cli 2>&1)\n   143\t  if printf '%s' \"$got\" | grep -q '^# Orca CLI'; then pass \"$b skills get orca-cli prints the guide outside Orca\"\n   144\t  else fail \"$b skills get\" \"$(printf '%s' \"$got\" | head -3)\"; fi\n   145\tdone\n   146\t\n   147\t# The rev is pinned by hand next to the version; the app knows its own.\n   148\trev=$(nix eval --raw \"$HM.home.file\" --apply 'f: f.\".claude/skills/orca-cli\".source' | sed -nE 's|.*-orca-skills-([0-9a-f]{40})/.*|\\1|p')\n   149\tif [ -n \"$rev\" ] && grep -aqF \"sourceCommit:\\`$rev\\`\" \"$contents/resources/app.asar\"; then\n   150\t  pass \"skills rev ${rev:0:8} is this build's sourceCommit\"\n   151\telse fail \"skills rev\" \"'${rev:-unparsed}' is not the sourceCommit in app.asar\"; fi\n   152\t\n   153\tfor s in $SKILLS; do\n   154\t  src=$(nix eval --raw \"$HM.home.file\" --apply \"f: toString f.\\\".claude/skills/$s\\\".source\" 2>/dev/null) \\\n   155\t    || { fail \"$s\" \"no home.file .claude/skills/$s\"; continue; }\n   156\t  # The source is a subpath of a fetch; realise the fetch's derivation itself.\n   157\t  srcdrv=$(nix eval --raw \"$HM.home.file\" --apply \\\n   158\t    \"f: builtins.head (builtins.attrNames (builtins.getContext f.\\\".claude/skills/$s\\\".source))\" 2>/dev/null)\n   159\t  nix-store --realise \"$srcdrv\" >/dev/null\n   160\t  # Every file the manifest lists for the skill, as \"<sha256>  <path>\" lines.\n   161\t  want=$(jq -r --arg n \"$s\" '.skills[] | select(.name == $n) | .files[] | \"\\(.exactSha256)  \\(.path)\"' \"$manifest\")\n   162\t  [ -n \"$want\" ] || { fail \"$s\" \"no entry in the manifest\"; continue; }\n   163\t  if out=$(cd \"$src\" 2>/dev/null && printf '%s\\n' \"$want\" | sha256sum --quiet -c - 2>&1); then\n   164\t    pass \"$s matches this build's manifest ($(printf '%s\\n' \"$want\" | wc -l) files)\"\n   165\t  else fail \"$s\" \"${out:-$src is missing}\"; fi\n   166\tdone\n   167\t\n   168\tprintf '\\n%d/%d passed\\n' \"$((n-fails))\" \"$n\"\n   169\t[ \"$fails\" -eq 0 ]","is_error":false}]},"uuid":"e82a8b83-7dc5-4b04-8381-be3f12d85964","timestamp":"2026-10-24T11:07:44.977Z","toolUseResult":{"stdout":"     1\t#!/usr/bin/env bash\