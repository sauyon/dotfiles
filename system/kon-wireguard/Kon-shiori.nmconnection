# shiori's end of the Kon WireGuard overlay (the UCG's), as NetworkManager
# keyfile. Installed by ../network.sh, deliberately NOT by ./deploy's etc/ copy
# -- that copy preserves this repo's 644, and NetworkManager ignores a keyfile
# carrying secrets unless it is 600 and root-owned.
#
# Three values are absent on purpose and spliced in at install time: two read
# back off whatever profile is already on the device, one from a file
# ~/.config/kon/wg-endpoint (see the endpoint comment below).
#
#   private-key               this device's, under [wireguard]
#   the [wireguard-peer.*] id the home server's public key
#   endpoint                   the home server's address, @WG_ENDPOINT@
#
# None belongs in a public repo. The private key is per-device, so there is
# nothing to share between hosts anyway; the peer key and the endpoint name
# the home server, and the endpoint's name resolves to a residential WAN
# address -- publishing it would publish that.
#
# The shape here is the split tunnel, and it is load-bearing: allowed-ips is
# 0.0.0.0/0 so the peer may *carry* anything, while ip4-auto-default-route=false
# stops that from becoming a default route and the three route= lines name what
# actually goes over the tunnel. A full tunnel here once blacked the host out.

[connection]
id=Kon-shiori
uuid=e1722ba7-25e3-4aa3-86a0-74e4cf00b703
type=wireguard
interface-name=Kon-shiori
autoconnect=true

[wireguard]
mtu=1368
ip4-auto-default-route=false
ip6-auto-default-route=false

[wireguard-peer.@PEER_PUBKEY@]
allowed-ips=0.0.0.0/0;::/0;
# A name, not a literal address, and the name is not this file's to name: it
# carries the home WAN address in public DNS, and this repo is public. The
# value is spliced in at install time by install_wg_profile, from
# ~/.config/kon/wg-endpoint (home.nix materializes it from dotfiles-private),
# alongside the two values this profile already reads back off the device.
#
# Why a spliced name rather than the address: the home line is a dynamic
# residential lease and NetworkManager re-resolves this on every activation,
# so an address change heals on the next rebind. The old profile pinned the
# IP, so a lease change presented exactly as the outage this file responds to
# -- an activated tunnel with zero handshakes ever.
endpoint=@WG_ENDPOINT@
# The old profile had no keepalive, so the NAT mapping the home server held for
# this peer aged out with nothing to re-punch it. 25s is the usual floor for
# surviving a consumer NAT.
persistent-keepalive=25

[ipv4]
method=manual
address1=10.9.0.2/32
# No dns= here, on either family. NetworkManager writes a profile's resolvers
# into /etc/resolv.conf ahead of the wifi's, and glibc tries them in order, so
# whenever the tunnel is not carrying traffic every uncached lookup on the host
# waits 6s per tunnel resolver before falling through -- 8-17s measured, enough
# to stall every new shell behind gcloud's metadata probe. It was kept for the
# fleet names, but those resolve publicly now (measured from 1.1.1.1 on
# 2026-10-13; the names themselves are in dotfiles-private), so the search
# domain alone is enough.
dns-search=ko.ag;
never-default=true
route1=10.9.0.0/24
route2=10.0.7.0/24
route3=10.0.10.0/24

[ipv6]
method=manual
address1=fd38:b020:137a:f48f::4/128
dns-search=ko.ag;
never-default=true
route1=fd38:b020:137a:f48f::/64
addr-gen-mode=default
