lications/orca-ide.desktop\n       for size in 16 24 32 48 64 128 256 512; do\n@@ -66,9 +111,9 @@ let\n           $out/share/icons/hicolor/''${size}x''${size}/apps/orca-ide.png\n       done\n       substituteInPlace $out/share/applications/orca-ide.desktop \\\n-        --replace-fail 'Exec=AppRun' 'Exec=orca-ide'\n+        --replace-fail 'Exec=AppRun' 'Exec=orca-ide-app'\n     '';\n-    meta.mainProgram = \"orca-ide\";\n+    meta.mainProgram = \"orca-ide-app\";\n   };\n   # Hermetic: nixpkgs' own conf.d (store paths, the full standard alias set),\n   # whose 50-user.conf pulls in ~/.config/fontconfig -- home-manager's font\n@@ -86,16 +131,85 @@ let\n       <cachedir prefix=\"xdg\">fontconfig</cachedir>\n     </fontconfig>\n   '';\n-  # Extracted once, shared by the wrapper's extraInstallCommands below;\n-  # let bindings are recursive, so position in the block does not matter.\n+  # Extracted once, shared by the GUI's extraInstallCommands and orcaCli's\n+  # runScript; let bindings are recursive, so position does not matter.\n   appimageContents = pkgs.appimageTools.extract { inherit pname version src; };\n+\n+  # nixGL wrap: without it the FHS env resolves GBM/DRI via the NixOS-only\n+  # /run/opengl-driver path and falls back to software rendering — the\n+  # same reason parsec gets it.\n+  orcaGui = config.lib.nixGL.wrap orca;\n+\n+  # The CLI, as `orca-ide` (what the skills run outside an Orca terminal on\n+  # Linux) and `orca` (their name for it elsewhere; inside an Orca terminal\n+  # the app's own shim dir comes first on PATH and wins). Upstream's\n+  # resources/bin/orca-ide runs the bundled Electron in node mode on\n+  # out/cli/index.js. Orca's own installer only reaches an Orca terminal: a\n+  # shim dir on PATH there, and a ~/.local/bin symlink to a raw store path\n+  # that runs Electron against the host's libraries. This runs that same\n+  # script in an FHS env of its own, so it works from any shell. Its own,\n+  # not the GUI's: wrapType2 pins runScript to appimage-exec.sh, whose AppRun execs the\n+  # Electron binary and never the CLI script. defaultFhsEnvArgs already\n+  # carries libsecret.\n+  #\n+  # ORCA_APP_EXECUTABLE: `orca-ide open` otherwise spawns process.execPath,\n+  # the raw Electron in this env — no wayland flag, fonts or nixGL, so it\n+  # exits on a Hyprland-only session. The CLI's launcher honours this\n+  # override and strips ELECTRON_RUN_AS_NODE before spawning it; `serve`\n+  # also runs it in node mode, which orca-ide-app above allows for.\n+  # tests/orca-cli-skills.sh.\n+  orcaCli = pkgs.buildFHSEnv (pkgs.appimageTools.defaultFhsEnvArgs // {\n+    pname = \"orca-cli\";\n+    inherit version;\n+    executableName = \"orca-ide\";\n+    runScript = \"${appimageContents}/resources/bin/orca-ide\";\n+    extraBwrapArgs = [ \"--setenv ORCA_APP_EXECUTABLE ${orcaGui}/bin/orca-ide-app\" ];\n+    # bin/orca-ide is buildFHSEnv's bwrap launcher; it moves aside so the\n+    # name is a forwardSignals wrapper, for `orca-ide serve` above all.\n+    extraInstallCommands = ''\n+      mv $out/bin/orca-ide $out/bin/.orca-ide-bwrap\n+      cat > $out/bin/orca-ide <<'EOF'\n+      #!${pkgs.runtimeShell}\n+      ${forwardSignals \"${placeholder \"out\"}/bin/.orca-ide-bwrap\"}\n+      EOF\n+      chmod +x $out/bin/orca-ide\n+      ln -s orca-ide $out/bin/orca\n+    '';\n+  });\n+\n+  # Orca's agent skills, from the repo at the commit this AppImage was built\n+  # from: `orca skills install` pins `npx skills add` to it, and the bundled\n+  # resources/skills/current-manifest.json holds their sha256s. Bump this rev\n+  # with the version — it is the `sourceCommit` in out/main/index.js of\n+  # app.asar, and the test holds it to that. A fetch in this module rather\n+  # than a flake input, because the rev tracks `version` above, not the\n+  # repo's head; `nix flake update` does not touch it. The rev is in the\n+  # store name so a rev bump without a hash bump fails to fetch instead of\n+  # reusing the old tree. The skills are stubs that call\n+  # `orca-ide skills get <name>`, so they need orcaCli above.\n+  #\n+  # A subset of the bundled ten: no Jira, no emulator. Each is a read-only\n+  # store symlink, so Orca's own Settings > Skills \"update\" (npx skills add)\n+  # will fail on them or replace them, and home-manager then refuses to\n+  # clobber; update by bumping here instead.\n+  orcaSkillsSrc = pkgs.fetchFromGitHub rec {\n+    name = \"orca-skills-${rev}\";\n+    owner = \"stablyai\";\n+    repo = \"orca\";\n+    rev = \"e6f7fba58e8e47b45e4343f99101b3ca9e05a5da\";\n+    hash = \"REDACTED\";\n+  };\n+  orcaSkills = [\n+    \"orca-cli\" \"orchestration\" \"computer-use\" \"orca-per-workspace-env\"\n+    \"orca-linear\" \"linear-tickets\"\n+  ];\n in\n {\n   home.packages =\n-    lib.optionals (!isDarwin && isDesktop) [\n-    # nixGL wrap: without it the FHS env resolves GBM/DRI via the NixOS-only\n-    # /run/opengl-driver path and falls back to software rendering — the\n-    # same reason parsec gets it.\n-      (config.lib.nixGL.wrap orca)\n-    ];\n+    lib.optionals (!isDarwin && isDesktop) [ orcaGui orcaCli ];\n+\n+  home.file = lib.mkIf (!isDarwin && isDesktop) (lib.listToAttrs (map (name: {\n+    name = \".claude/skills/${name}\";\n+    value.source = \"${orcaSkillsSrc}/skills/${name}\";\n+  }) orcaSkills));\n }\ndiff --git a/tests/sandbox-fonts.sh b/tests/sandbox-fonts.sh\nindex 8061ca50..7ed64b4a 100755\n--- a/tests/sandbox-fonts.sh\n+++ b/tests/sandbox-fonts.sh\n@@ -22,7 +22,7 @@\n # Usage:\n #   tests/sandbox-fonts.sh               build this host's orca and test it\n #   tests/sandbox-fonts.sh <orca-path>   test a given build, e.g. the live one:\n-#                                        $(dirname $(dirname $(readlink -f ~/.nix-profile/bin/orca-ide)))\n+#                                        $(dirname $(dirname $(readlink -f ~/.nix-profile/bin/orca-ide-app)))\n \n set -u\n set -o pipefail\n@@ -34,7 +34,7 @@ fail() { n=$((n+1)); echo \"FAIL $1: $2\"; fails=$((fails+1)); }\n ORCA=\"${1:-}\"\n if [ -z \"$ORCA\" ]; then\n   FLAKE=$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/..\" && pwd)\n-  drv=$(nix eval --raw \"$FLAKE#homeConfigurations.$(cat /etc/hostname).config.home.packages\" \\\n+  drv=$(nix eval --raw \"$FLAKE#homeConfigurations.$(cat /etc/hostname 2>/dev/null || uname -n).config.home.packages\" \\\n     --apply 'ps: (builtins.head (builtins.filter (p: builtins.match \".*orca-[0-9.]+\" (p.name or \"\") != null) ps)).drvPath') \\\n     || { echo \"orca is not in home.packages here\" >&2; exit 1; }\n   ORCA=$(nix-store --realise \"$drv\" | tail -1) || { echo \"could not build orca\" >&2; exit 1; }\n     1\t{ config, lib, pkgs, machine, ... }:\n     2\t\n     3\tlet\n     4\t  # Run a bwrap launcher in the background and forward TERM and HUP to the\n     5\t  # process inside its sandbox. bwrap forwards no signals: with\n     6\t  # --die-with-parent a TERM SIGKILLs the payload before it can clean up,\n     7\t  # without it the payload is orphaned. Either way `orca-ide serve` cannot\n     8\t  # be stopped cleanly -- systemd's unit (KillMode=process), the serve\n     9\t  # supervisor and a plain kill all signal the outermost pid. Without a pid\n    10\t  # namespace (buildFHSEnv's default), bwrap's one child is the payload\n    11\t  # itself, every layer below exec'ing the next.\n    12\t  #\n    13\t  # A background job in a non-interactive shell gets stdin from /dev/null\n    14\t  # and SIGINT/SIGQUIT ignored; `<&0` and env --default-signal undo both, so\n    15\t  # stdin and Ctrl-C (which the terminal delivers to the whole foreground\n    16\t  # group, payload included) behave as with a plain exec. tests/orca-cli-skills.sh.\n    17\t  forwardSignals = target: ''\n    18\t    # forward-signals\n    19\t    ${pkgs.coreutils}/bin/env --default-signal=INT,QUIT ${target} \"$@\" <&0 &\n    20\t    child=$!\n    21\t    fwd() {\n    22\t      kids=$(cat /proc/$child/task/*/children 2>/dev/null)\n    23\t      kill -s \"$1\" ''${kids:-$child} 2>/dev/null\n    24\t    }\n    25\t    trap 'fwd TERM' TERM\n    26\t    trap 'fwd HUP' HUP\n    27\t    trap : INT\n    28\t    while :; do\n    29\t      wait $child; rc=$?\n    30\t      kill -0 $child 2>/dev/null || exit $rc\n    31\t    done\n    32\t  '';\n    33\t\n    34\t  isDarwin = pkgs.stdenv.hostPlatform.isDarwin;\n    35\t  isDesktop = machine.gui or true;\n    36\t\n    37\t  # Orca (onorca.dev) — the agent IDE: parallel CLI agents, each in its own\n    38\t  # worktree. Closed-source Electron app, not in nixpkgs (nixpkgs' `orca` is\n    39\t  # the GNOME screen reader), so this packages the official Linux AppImage.\n    40\t  # The electron-updater feed in each GitHub release, latest-linux.yml, is\n    41\t  # the source of truth for version + sha512 when bumping: the yml's sha512\n    42\t  # is the AppImage's, checked against\n    43\t  # the download with `nix hash to-sri --type sha512 <sha512sum>`.\n    44\t  # https://github.com/stablyai/orca/releases/latest/download/latest-linux.yml\n    45\t  pname = \"orca\";\n    46\t  version = \"1.4.238\";\n    47\t  src = pkgs.fetchurl {\n    48\t    url = \"https://github.com/stablyai/orca/releases/download/v${version}/orca-linux.AppImage\";\n    49\t    hash = \"REDACTED/sHSKlfJa4c1O2MCcdJhLrxCVm/NVKT+JtghzxoEsQ==\";\n    50\t  };\n    51\t\n    52\t  # Wrap the AppImage (not autoPatchelf of the .deb) so the Electron stack\n    53\t  # runs in appimageTools' FHS env, which works on non-NixOS hosts. Electron\n    54\t  # safeStorage wants libsecret at runtime.\n    55\t  orca = pkgs.appimageTools.wrapType2 {\n    56\t    inherit pname version src;\n    57\t    extraPkgs = pkgs: [ pkgs.libsecret ];\n    58\t    # The sandbox gets its own fontconfig, the way every other nix GUI app here\n    59\t    # gets a nix-generated FONTCONFIG_FILE, instead of the distro's.\n    60\t    # buildFHSEnv binds the host's /etc/fonts in, assuming NixOS; Arch's conf.d\n    61\t    # links point into /usr/share/fontconfig, which the sandbox's /usr replaces,\n    62\t    # so all of them dangled and every family fell to Montserrat Thin. See\n    63\t    # fontsConf below. tests/sandbox-fonts.sh.\n    64\t    extraBwrapArgs = [ \"--setenv FONTCONFIG_FILE ${fontsConf}\" ];\n    65\t    # `orca-ide open` (orcaCli below) spawns the GUI detached, but every\n    66\t    # wrapper layer execs the next, so this bwrap is the CLI's own child, and\n    67\t    # --die-with-parent SIGKILLs the window the moment `open` returns.\n    68\t    dieWithParent = false;\n    69\t    # The AppImage ships bin/orca and an orca-ide.desktop. Upstream's Linux\n    70\t    # install makes `orca-ide` the CLI, and Orca's skills tell agents to run\n    71\t    # exactly that outside an Orca terminal, so `orca-ide` is orcaCli below\n    72\t    # and the GUI is `orca-ide-app`, which the desktop Exec and\n    73\t    # meta.mainProgram use. appimageTools keeps the AppImage's own bin name,\n    74\t    # so the wrapper is renamed by hand.\n    75\t    #\n    76\t    # --ozone-platform=wayland: Orca's startup gate picks X11 when neither\n    77\t    # --ozone-platform nor ELECTRON_OZONE_PLATFORM_HINT says otherwise, and on\n    78\t    # a Hyprland-only session there is no X server to stat — measured: the\n    79\t    # bare launch exits 1 with \"needs a usable display server\", and the\n    80\t    # explicit wayland switch keeps it running (timeout kill at 20s, exit 124).\n    81\t    # An env var would work from a shell but not a desktop-file launch, so it\n    82\t    # is a flag on the command line.\n    83\t    #\n    84\t    # The flag lands in extraInstallCommands, not postFixup: wrapType2 is a\n    85\t    # buildFHSEnv, whose buildCommand short-circuits genericBuild's phase\n    86\t    # list, so postFixup never runs. The bwrap launcher moves aside to\n    87\t    # .orca-ide-unwrapped and orca-ide-app becomes a forwardSignals wrapper\n    88\t    # that prepends the flag and passes \"$@\" through -- except in node mode: the CLI's\n    89\t    # `serve` probes ORCA_APP_EXECUTABLE (orcaCli below) with\n    90\t    # ELECTRON_RUN_AS_NODE=1 and a script as argv, and Node rejects the flag\n    91\t    # (\"bad option\", exit 9), silently losing the orcad runtime. Node mode\n    92\t    # still goes through AppRun, which adds --no-sandbox -- just as fatal --\n    93\t    # if `unshare -Ur` fails in the sandbox; nested user namespaces work on\n    94\t    # these hosts, so it does not. Hand-written: clearer than makeShellWrapper\n    95\t    # with a --run early exec.\n    96\t    extraInstallCommands = ''\n    97\t      mv $out/bin/orca $out/bin/.orca-ide-unwrapped\n    98\t      cat > $out/bin/orca-ide-app <<'EOF'\n    99\t      #!${pkgs.runtimeShell}\n   100\t      if [ -z \"''${ELECTRON_RUN_AS_NODE:-}\" ]; then\n   101\t        set -- --ozone-platform=wayland \"$@\"\n   102\t      fi\n   103\t      ${forwardSignals \"${placeholder \"out\"}/bin/.orca-ide-unwrapped\"}\n   104\t      EOF\n   105\t      chmod +x $out/bin/orca-ide-app\n   106\t      install -Dm444 ${appimageContents}/orca-ide.desktop \\\n   107\t        $out/share/applications/orca-ide.desktop\n   108\t      for size in 16 24 32 48 64 128 256 512; do\n   109\t        install -Dm444 \\\n   110\t          ${appimageContents}/usr/share/icons/hicolor/''${size}x''${size}/apps/orca-ide.png \\\n   111\t          $out/share/icons/hicolor/''${size}x''${size}/apps/orca-ide.png\n   112\t      done\n   113\t      substituteInPlace $out/share/applications/orca-ide.desktop \\\n   114\t        --replace-fail 'Exec=AppRun' 'Exec=orca-ide-app'\n   115\t    '';\n   116\t    meta.mainProgram = \"orca-ide-app\";\n   117\t  };\n   118\t  # Hermetic: nixpkgs' own conf.d (store paths, the full standard alias set),\n   119\t  # whose 50-user.conf pulls in ~/.config/fontconfig -- home-manager's font\n   120\t  # dirs, i.e. the nix-profile fonts every other app here uses. Plus DejaVu:\n   121\t  # Orca's Linux terminalFontFamily default is exactly \"DejaVu Sans Mono\" with\n   122\t  # no fallback, and Chromium refuses fontconfig's alias to another mono font,\n   123\t  # so without it the terminal lays a proportional fallback out on a mono grid.\n   124\t  # Scoped to orca rather than the profile because only orca hardcodes it.\n   125\t  fontsConf = pkgs.writeText \"orca-fonts.conf\" ''\n   126\t    <?xml version=\"1.0\"?>\n   127\t    <!DOCTYPE fontconfig SYSTEM \"urn:fontconfig:fonts.dtd\">\n   128\t    <fontconfig>\n   129\t      <include ignore_missing=\"no\">${pkgs.fontconfig.out}/etc/fonts/conf.d</include>\n   130\t      <dir>${pkgs.dejavu_fonts}/share/fonts</dir>\n   131\t      <cachedir prefix=\"xdg\">fontconfig</cachedir>\n   132\t    </fontconfig>\n   133\t  '';\n   134\t  # Extracted once, shared by the GUI's extraInstallCommands and orcaCli's\n   135\t  # runScript; let bindings are recursive, so position does not matter.\n   136\t  appimageContents = pkgs.appimageTools.extract { inherit pname version src; };\n   137\t\n   138\t  # nixGL wrap: without it the FHS env resolves GBM/DRI via the NixOS-only\n   139\t  # /run/opengl-driver path and falls back to software rendering — the\n   140\t  # same reason parsec gets it.\n   141\t  orcaGui = config.lib.nixGL.wrap orca;\n   142\t\n   143\t  # The CLI, as `orca-ide` (what the skills run outside an Orca terminal on\n   144\t  # Linux) and `orca` (their name for it elsewhere; inside an Orca terminal\n   145\t  # the app's own shim dir comes first on PATH and wins). Upstream's\n   146\t  # resources/bin/orca-ide runs the bundled Electron in node mode on\n   147\t  # out/cli/index.js. Orca's own installer only reaches an Orca terminal: a\n   148\t  # shim dir on PATH there, and a ~/.local/bin symlink to a raw store path\n   149\t  # that runs Electron against the host's libraries. This runs that same\n   150\t  # script in an FHS env of its own, so it works from any shell. Its own,\n   151\t  # not the GUI's: wrapType2 pins runScript to appimage-exec.sh, whose AppRun execs the\n   152\t  # Electron binary and never the CLI script. defaultFhsEnvArgs already\n   153\t  # carries libsecret.\n   154\t  #\n   155\t  # ORCA_APP_EXECUTABLE: `orca-ide open` otherwise spawns process.execPath,\n   156\t  # the raw Electron in this env — no wayland flag, fonts or nixGL, so it\n   157\t  # exits on a Hyprland-only session. The CLI's launcher honours this\n   158\t  # override and strips ELECTRON_RUN_AS_NODE before spawning it; `serve`\n   159\t  # also runs it in node mode, which orca-ide-app above allows for.\n   160\t  # tests/orca-cli-skills.sh.\n   161\t  orcaCli = pkgs.buildFHSEnv (pkgs.appimageTools.defaultFhsEnvArgs // {\n   162\t    pname = \"orca-cli\";\n   163\t    inherit version;\n   164\t    executableName = \"orca-ide\";\n   165\t    runScript = \"${appimageContents}/resources/bin/orca-ide\";\n   166\t    extraBwrapArgs = [ \"--setenv ORCA_APP_EXECUTABLE ${orcaGui}/bin/orca-ide-app\" ];\n   167\t    # bin/orca-ide is buildFHSEnv's bwrap launcher; it moves aside so the\n   168\t    # name is a forwardSignals wrapper, for `orca-ide serve` above all.\n   169\t    extraInstallCommands = ''\n   170\t      mv $out/bin/orca-ide $out/bin/.orca-ide-bwrap\n   171\t      cat > $out/bin/orca-ide <<'EOF'\n   172\t      #!${pkgs.runtimeShell}\n   173\t      ${forwardSignals \"${placeholder \"out\"}/bin/.orca-ide-bwrap\"}\n   174\t      EOF\n   175\t      chmod +x $out/bin/orca-ide\n   176\t      ln -s orca-ide $out/bin/orca\n   177\t    '';\n   178\t  });\n   179\t\n   180\t  # Orca's agent skills, from the repo at the commit this AppImage was built\n   181\t  # from: `orca skills install` pins `npx skills add` to it, and the bundled\n   182\t  # resources/skills/current-manifest.json holds their sha256s. Bump this rev\n   183\t  # with the version — it is the `sourceCommit` in out/main/index.js of\n   184\t  # app.asar, and the test holds it to that. A fetch in this module rather\n   185\t  # than a flake input, because the rev tracks `version` above, not the\n   186\t  # repo's head; `nix flake update` does not touch it. The rev is in the\n   187\t  # store name so a rev bump without a hash bump fails to fetch instead of\n   188\t  # reusing the old tree. The skills are stubs that call\n   189\t  # `orca-ide skills get <name>`, so they need orcaCli above.\n   190\t  #\n   191\t  # A subset of the bundled ten: no Jira, no emulator. Each is a read-only\n   192\t  # store symlink, so Orca's own Settings > Skills \"update\" (npx skills add)\n   193\t  # will fail on them or replace them, and home-manager then refuses to\n   194\t  # clobber; update by bumping here instead.\n   195\t  orcaSkillsSrc = pkgs.fetchFromGitHub rec {\n   196\t    name = \"orca-skills-${rev}\";\n   197\t    owner = \"stablyai\";\n   198\t    repo = \"orca\";\n   199\t    rev = \"e6f7fba58e8e47b45e4343f99101b3ca9e05a5da\";\n   200\t    hash = \"REDACTED\";\n   201\t  };\n   202\t  orcaSkills = [\n   203\t    \"orca-cli\" \"orchestration\" \"computer-use\" \"orca-per-workspace-env\"\n   204\t    \"orca-linear\" \"linear-tickets\"\n   205\t  ];\n   206\tin\n   207\t{\n   208\t  home.packages =\n   209\t    lib.optionals (!isDarwin && isDesktop) [ orcaGui orcaCli ];\n   210\t\n   211\t  home.file = lib.mkIf (!isDarwin && isDesktop) (lib.listToAttrs (map (name: {\n   212\t    name = \".claude/skills/${name}\";\n   213\t    value.source = \"${orcaSkillsSrc}/skills/${name}\";\n   214\t  }) orcaSkills));\n   215\t}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"5c998e84-d39a-4b4c-95dd-572837259d82","context":{"git_state":{"cwd":"/home/sauyon/devel/dotfiles/.drovr/wt/orca-cli-skills","root":"/home/sauyon/devel/dotfiles/.drovr/wt/orca-cli-skills","branch":"orca-cli-skills","default_branch":null,"status":{"clean":true,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"forge.ko.ag","remote":"sauyon/dotfiles","visibility":"unknown"},"push_remote":"origin","remotes":[{"name":"origin","host":"forge.ko.ag","remote":"sauyon/dotfiles","visibility":"unknown"}],"visibility_cache":[{"host":"forge.ko.ag","remote":"sauyon/dotfiles","visibility":"unknown"}]}},"live_cwd":"/home/sauyon/devel/dotfiles/.drovr/wt/orca-cli-skills","platform":"linux"}},"sandboxed":false,"sourceToolAssistantUUID":"42d22e50-b126-4530-b8bf-7d20b18940b3","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"userType":"external","entrypoint":"cli","cwd":"/home/sauyon/devel/dotfiles/.drovr/wt/orca-cli-skills","sessionId":"d19ff9ff-38c8-4378-ac54-4f4061f74300","version":"2.1.308","gitBranch":"orca-cli-skills"}
{"parentUuid":"06c12195-9321-48e5-8ee7-00548460d82b","isSidechain":true,"agentId":"a2520a44972818a06","attachment":{"type":"nested_memory","path":"/home/sauyon/devel/dotfiles/.drovr/wt/orca-cli-skills/CLAUDE.md","content":{"path":"/home/sauyon/devel/dotfiles/.drovr/wt/orca-cli-skills/CLAUDE.md","type":"Project","content":"## NO EMAILS\n\n**Never write an email address into anything.** Not into files, commit messages,\ndocs, notes, handoffs or scratch files — mine, colleagues', or service accounts.\nThis repo is public, and an address is a durable identifier that spreads: it\nleaks the work/personal boundary, it enumerates people, and once written it gets\ncopied onward.\n\nRefer to an account by its **role** — \"the personal Google account\", \"the work\naccount\", \"the project's GCS service agent\" — or record the command that\nrecovers the identity at read time (`gcloud config get-value account`) rather\nthan pasting its output. Role-based wording is better documentation anyway: \"must\nbe the personal account, not the work one\" survives an address change; a pasted\naddress does not.\n\nIf an address seems genuinely load-bearing, ask first.\n\nThe exception is the git identity already configured in `home.nix`, which git\nrequires and which is on every commit regardless.\n\n## Commit and Push Policy\n\nThis is a personal dotfiles repo on `master`. When asked to commit and push, do both without asking for confirmation. The global \"ask before public communications\" rule does not apply here.\n\n## Applying config: use `hms`, not `home-manager switch`\n\n`hms` (defined in `home.nix`, documented in `README.md`) pushes, waits for the\ncommit's CI run on `forge.ko.ag`, then switches — so the switch is a download of\nthe closure the in-cluster runner built, not a local compile. Expect it to block\nfor ten-odd minutes. `hms --local` builds here instead.\n\nIt refuses on a dirty tree and on a checkout behind `origin/master`. **Both\nrefusals are the feature.** CI can only build a pushed commit, so do not route\naround them with a bare `home-manager switch` — commit and push, or pass\n`--local` deliberately and say that you did.\n\nIf a run goes red, `hms` prints the job's `error:` lines; read those rather than\nre-running blind. Background on why CI is worth waiting for — and the 600s attic\ntransfer ceiling that made it unreliable for its first 61 runs — is in\n`docs/ci-nix-home.md`.\n","contentDiffersFromDisk":false},"displayPath":"CLAUDE.md"},"type":"attachment","uuid":"7709a300-0976-433e-98f7-629a77b122f9","timestamp":"2026-10-24T11:07:45.004Z","rendered":[{"content":"<system-reminder>\nContents of /home/sauyon/devel/dotfiles/.drovr/wt/orca-cli-skills/CLAUDE.md:\n\n## NO EMAILS\n\n**Never write an email address into anything.** Not into files, commit messages,\ndocs, notes, handoffs or scratch files — mine, colleagues', or service accounts.\nThis repo is public, and an address is a durable identifier that spreads: it\nleaks the work/personal boundary, it enumerates people, and once written it gets\ncopied onward.\n\nRefer to an account by its **role** — \"the personal Google account\", \"the work\naccount\", \"the project's GCS service agent\" — or record the command that\nrecovers the identity at read time (`gcloud config get-value account`) rather\nthan pasting its output. Role-based wording is better documentation anyway: \"must\nbe the personal account, not the work one\" survives an address change; a pasted\naddress does not.\n\nIf an address seems genuinely load-bearing, ask first.\n\nThe exception is the git identity already configured in `home.nix`, which git\nrequires and which is on every commit regardless.\n\n## Commit and Push Policy\n\nThis is a personal dotfiles repo on `master`. When asked to commit and push, do both without asking for confirmation. The global \"ask before public communications\" rule does not apply here.\n\n## Applying config: use `hms`, not `home-manager switch`\n\n`hms` (defined in `home.nix`, documented in `README.md`) pushes, waits for the\ncommit's CI run on `forge.ko.ag`, then switches — so the switch is a download of\nthe closure the in-cluster runner built, not a local compile. Expect it to block\nfor ten-odd minutes. `hms --local` builds here instead.\n\nIt refuses on a dirty tree and on a checkout behind `origin/master`. **Both\nrefusals are the feature.** CI can only build a pushed commit, so do not route\naround them with a bare `home-manager switch` — commit and push, or pass\n`--local` deliberately and say that you did.\n\nIf a run goes red, `hms` prints the job's `error:` lines; read those rather than\nre-running blind. Background on why CI is worth waiting for — and the 600s attic\ntransfer ceiling that made it unreliable for its first 61 runs — is in\n`docs/ci-nix-home.md`.\n\n</system-reminder>"}],"renderedRole":"user","userType":"external","entrypoint":"cli","cwd":"/home/sauyon/devel/dotfiles/.drovr/wt/orca-cli-skills","sessionId":"d19ff9ff-38c8-4378-ac54-4f4061f74300","version":"2.1.308","gitBranch":"orca-cli-skills"}
