+// Serialize every refresh-token spend against a single OS-level flock, so a
+// bare `fj whoami` cannot race the `git-credential-fj` helper. Forgejo rotates
+// refresh tokens on every use and treats reuse as compromise evidence, so two
+// clients that each hold the same `refresh_token` see one succeed and the other
+// die with "token was already used" — even when their only contention is reading
+// `keys.json` between each other's writes. The lock path is the same one the
+// bash helper uses (and falls back through), so the helper and `fj` itself
+// share a single rendezvous point.
+//
+// Uses `fs2::FileExt::lock_exclusive` (a thin wrapper over `flock(2)`).
+// The kernel releases the lock on process exit, so a crash between the read
+// and the save cannot strand the grant. The two unix cfg-gated items below
+// leave the Windows build alone; the locking concern is no worse than it was
+// before.
+#[cfg(unix)]
+struct RefreshLock(std::fs::File);
+
+#[cfg(unix)]
+impl RefreshLock {
+    fn acquire() -> eyre::Result<Self> {
+        use std::os::unix::fs::OpenOptionsExt;
+        let path = lock_path();
+        if let Some(parent) = path.parent() {
+            // Best-effort: the parent is /run/user/<uid> or /tmp, both already
+            // present in practice. A failure here surfaces on the open() below
+            // anyway; trying to mkdir unconditionally would mask a real error.
+            let _ = std::fs::create_dir_all(parent);
+        }
+        let file = std::fs::OpenOptions::new()
+            .create(true)
+            .write(true)
+            .mode(0o600)
+            .open(&path)
+            .map_err(|e| eyre::eyre!("opening refresh lock {}: {}", path.display(), e))?;
+        file.lock_exclusive()
+            .map_err(|e| eyre::eyre!("acquiring refresh lock {}: {}", path.display(), e))?;
+        Ok(Self(file))
+    }
+}
+
+#[cfg(unix)]
+impl Drop for RefreshLock {
+    fn drop(&mut self) {
+        // Best-effort: `flock(2)` releases when the kernel tears the process
+        // down, so a missing unlock here just means the next racer waits the
+        // lifetime of the current syscall it interrupted — never longer than
+        // one network round-trip.
+        let _ = FileExt::unlock(&self.0);
+    }
+}
+
+#[cfg(unix)]
+fn lock_path() -> PathBuf {
+    if let Some(p) = std::env::var_os("FJ_LOCK_FILE") {
+        if !p.is_empty() {
+            return PathBuf::from(p);
+        }
+    }
+    let base = std::env::var_os("XDG_RUNTIME_DIR")
+        .filter(|s| !s.is_empty())
+        .map(PathBuf::from)
+        .or_else(|| {
+            std::env::var_os("TMPDIR")
+                .filter(|s| !s.is_empty())
+                .map(PathBuf::from)
+        })
+        .unwrap_or_else(|| PathBuf::from("/tmp"));
+    base.join("git-credential-fj.lock")
+}
