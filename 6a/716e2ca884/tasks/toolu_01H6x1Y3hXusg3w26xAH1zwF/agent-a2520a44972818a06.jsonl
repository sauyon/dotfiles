chine, ... }:\n     2\t\n     3\tlet\n     4\t  # Run a bwrap launcher in the background and forward TERM and HUP to the\n     5\t  # process inside its sandbox. bwrap forwards no signals: with\n     6\t  # --die-with-parent a TERM SIGKILLs the payload before it can clean up,\n     7\t  # without it the payload is orphaned. Either way `orca-ide serve` cannot\n     8\t  # be stopped cleanly -- systemd's unit (KillMode=process), the serve\n     9\t  # supervisor and a plain kill all signal the outermost pid. Without a pid\n    10\t  # namespace (buildFHSEnv's default), bwrap's one child is the payload\n    11\t  # itself, every layer below exec'ing the next.\n    12\t  #\n    13\t  # A background job in a non-interactive shell gets stdin from /dev/null\n    14\t  # and SIGINT/SIGQUIT ignored; `<&0` and env --default-signal undo both, so\n    15\t  # stdin and Ctrl-C (which the terminal delivers to the whole foreground\n    16\t  # group, payload included) behave as with a plain exec. tests/orca-cli-skills.sh.\n    17\t  forwardSignals = target: ''\n    18\t    # forward-signals\n    19\t    ${pkgs.coreutils}/bin/env --default-signal=INT,QUIT ${target} \"$@\" <&0 &\n    20\t    child=$!\n    21\t    fwd() {\n    22\t      kids=$(cat /proc/$child/task/*/children 2>/dev/null)\n    23\t      kill -s \"$1\" ''${kids:-$child} 2>/dev/null\n    24\t    }\n    25\t    trap 'fwd TERM' TERM\n    26\t    trap 'fwd HUP' HUP\n    27\t    trap : INT\n    28\t    while :; do\n    29\t      wait $child; rc=$?\n    30\t      kill -0 $child 2>/dev/null || exit $rc\n    31\t    done\n    32\t  '';\n    33\t\n    34\t  isDarwin = pkgs.stdenv.hostPlatform.isDarwin;\n    35\t  isDesktop = machine.gui or true;\n    36\t\n    37\t  # Orca (onorca.dev) — the agent IDE: parallel CLI agents, each in its own\n    38\t  # worktree. Closed-source Electron app, not in nixpkgs (nixpkgs' `orca` is\n    39\t  # the GNOME screen reader), so this packages the official Linux AppImage.\n    40\t  # The electron-updater feed in each GitHub release, latest-linux.yml, is\n    41\t  # the source of truth for version + sha512 when bumping: the yml's sha512\n    42\t  # is the AppImage's, checked against\n    43\t  # the download with `nix hash to-sri --type sha512 <sha512sum>`.\n    44\t  # https://github.com/stablyai/orca/releases/latest/download/latest-linux.yml\n    45\t  pname = \"orca\";\n    46\t  version = \"1.4.238\";\n    47\t  src = pkgs.fetchurl {\n    48\t    url = \"https://github.com/stablyai/orca/releases/download/v${version}/orca-linux.AppImage\";\n    49\t    hash = \"REDACTED/sHSKlfJa4c1O2MCcdJhLrxCVm/NVKT+JtghzxoEsQ==\";\n    50\t  };\n    51\t\n    52\t  # Wrap the AppImage (not autoPatchelf of the .deb) so the Electron stack\n    53\t  # runs in appimageTools' FHS env, which works on non-NixOS hosts. Electron\n    54\t  # safeStorage wants libsecret at runtime.\n    55\t  orca = pkgs.appimageTools.wrapType2 {\n    56\t    inherit pname version src;\n    57\t    extraPkgs = pkgs: [ pkgs.libsecret ];\n    58\t    # The sandbox gets its own fontconfig, the way every other nix GUI app here\n    59\t    # gets a nix-generated FONTCONFIG_FILE, instead of the distro's.\n    60\t    # buildFHSEnv binds the host's /etc/fonts in, assuming NixOS; Arch's conf.d\n    61\t    # links point into /usr/share/fontconfig, which the sandbox's /usr replaces,\n    62\t    # so all of them dangled and every family fell to Montserrat Thin. See\n    63\t    # fontsConf below. tests/sandbox-fonts.sh.\n    64\t    extraBwrapArgs = [ \"--setenv FONTCONFIG_FILE ${fontsConf}\" ];\n    65\t    # `orca-ide open` (orcaCli below) spawns the GUI detached, but every\n    66\t    # wrapper layer execs the next, so this bwrap is the CLI's own child, and\n    67\t    # --die-with-parent SIGKILLs the window the moment `open` returns.\n    68\t    dieWithParent = false;\n    69\t    # The AppImage ships bin/orca and an orca-ide.desktop. Upstream's Linux\n    70\t    # install makes `orca-ide