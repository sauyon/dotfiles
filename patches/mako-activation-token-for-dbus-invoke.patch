+// Read an activation token from stdin. Taken on stdin rather than as an
+// argument because argv is readable by any same-uid process through
+// /proc/<pid>/cmdline, and the token is a bearer credential.
+static int read_token(char *buf, size_t size) {
+	size_t len = 0;
+	while (len + 1 < size) {
+		ssize_t n = read(STDIN_FILENO, buf + len, size - len - 1);
+		if (n < 0) {
+			if (errno == EINTR) {
+				continue;
+			}
+			return -errno;
+		}
+		if (n == 0) {
+			break;
+		}
+		len += n;
+	}
+	buf[len] = '\0';
+
+	// Trim the trailing newline hyprctl and friends append.
+	while (len > 0 && (buf[len - 1] == '\n' || buf[len - 1] == '\r')) {
+		buf[--len] = '\0';
+	}
+
+	return 0;
+}
+
