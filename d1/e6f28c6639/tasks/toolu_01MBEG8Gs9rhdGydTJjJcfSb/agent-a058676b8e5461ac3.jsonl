l\n  pname = \"orca\";\n  version = \"1.4.238\";\n  src = pkgs.fetchurl {\n    url = \"https://github.com/stablyai/orca/releases/download/v${version}/orca-linux.AppImage\";\n    hash = \"REDACTED/sHSKlfJa4c1O2MCcdJhLrxCVm/NVKT+JtghzxoEsQ==\";\n  };","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"4e4ffb9b-9b3e-4ab5-9517-b35b1668d565","context":{"git_state":{"cwd":"/home/sauyon/devel/dotfiles/.drovr/wt/orca-cli-skills","root":"/home/sauyon/devel/dotfiles/.drovr/wt/orca-cli-skills","branch":"orca-cli-skills","default_branch":null,"status":{"clean":true,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"forge.ko.ag","remote":"sauyon/dotfiles","visibility":"unknown"},"push_remote":"origin","remotes":[{"name":"origin","host":"forge.ko.ag","remote":"sauyon/dotfiles","visibility":"unknown"}],"visibility_cache":[{"host":"forge.ko.ag","remote":"sauyon/dotfiles","visibility":"unknown"}]}},"live_cwd":"/home/sauyon/devel/dotfiles/.drovr/wt/orca-cli-skills","platform":"linux"}},"sandboxed":false,"sourceToolAssistantUUID":"d42cfd81-21b5-4048-a73e-28a3a0864062","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"userType":"external","entrypoint":"cli","cwd":"/home/sauyon/devel/dotfiles/.drovr/wt/orca-cli-skills","sessionId":"d19ff9ff-38c8-4378-ac54-4f4061f74300","version":"2.1.308","gitBranch":"orca-cli-skills"}
