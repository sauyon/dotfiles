+std::string CXDGActivationProtocol::mintTokenForIPC(std::chrono::steady_clock::duration expires) {
+    const auto TOKEN = g_pTokenManager->registerNewToken({}, expires);
+
+    m_sentTokens.push_back({TOKEN, nullptr});
+
+    // Client-minted tokens are capped at 10 per client in the commit handler
+    // above. Tokens minted here share a null client, so cap them the same way
+    // rather than letting a caller grow the vector without bound.
+    auto count = std::ranges::count_if(m_sentTokens, [](const auto& other) { return other.client == nullptr; });
+
+    while (count > 10) {
+        for (auto i = m_sentTokens.begin(); i != m_sentTokens.end(); ++i) {
+            if (i->client == nullptr) {
+                m_sentTokens.erase(i);
+                break;
+            }
+        }
+        --count;
+    }
+
+    return TOKEN;
+}
+
 void CXDGActivationProtocol::onManagerResourceDestroy(wl_resource* res) {
     std::erase_if(m_managers, [&](const auto& other) { return other->resource() == res; });
 }
