+static struct mako_notification *grab_selected_notification(
+		struct mako_state *state) {
+	struct mako_notification *notif;
+	wl_list_for_each(notif, &state->notifications, link) {
+		if (notif->id == state->grab.selected_id) {
+			return notif;
+		}
+	}
+	return NULL;
+}
+
+static void grab_select_first(struct mako_state *state) {
+	if (wl_list_empty(&state->notifications)) {
+		state->grab.selected_id = 0;
+		return;
+	}
+	struct mako_notification *first =
+		wl_container_of(state->notifications.next, first, link);
+	state->grab.selected_id = first->id;
+}
+
+// Keep the grab coherent after the notification list changes underneath it.
+// If everything is gone mako destroys its surfaces, and with them the keyboard
+// focus the user would need to press Escape -- so the grab has to release
+// itself or it would silently swallow the next notification's keystrokes.
+void refresh_keyboard_grab(struct mako_state *state) {
+	if (!state->grab.active) {
+		return;
+	}
+	if (wl_list_empty(&state->notifications)) {
+		set_keyboard_grab(state, false);
+		return;
+	}
+	if (grab_selected_notification(state) == NULL) {
+		grab_select_first(state);
+	}
+}
+
+static void grab_move_selection(struct mako_state *state, int delta) {
+	struct mako_notification *notif = grab_selected_notification(state);
+	if (notif == NULL) {
+		return;
+	}
+
+	struct wl_list *target = delta > 0 ? notif->link.next : notif->link.prev;
+	if (target == &state->notifications) {
+		// Wrap rather than dead-ending at the edge of the list.
+		target = delta > 0 ?
+			state->notifications.next : state->notifications.prev;
+	}
+
+	struct mako_notification *next = wl_container_of(target, next, link);
+	state->grab.selected_id = next->id;
+	set_dirty(notif->surface);
+	set_dirty(next->surface);
+}
+
+static const char *grab_nth_action(struct mako_notification *notif, int n) {
+	struct mako_action *action;
+	int i = 0;
+	wl_list_for_each(action, &notif->actions, link) {
+		if (i++ == n) {
+			return action->key;
+		}
+	}
+	return NULL;
+}
+
+// The whole point of grab mode: `serial` here comes from a wl_keyboard.key
+// event delivered to mako's own surface, so it is valid for mako's seat
+// resource and create_xdg_activation_token() will actually mint a token.
+// A serial is unobtainable over D-Bus, which is why makoctl invoke can fire an
+// action but can never raise the client.
+static void grab_invoke_binding(struct mako_state *state,
+		struct mako_seat *seat, uint32_t serial,
+		const struct mako_binding *binding) {
+	struct mako_notification *notif = grab_selected_notification(state);
+	if (notif == NULL) {
+		return;
+	}
+
+	struct mako_surface *surface = notif->surface;
+	const struct mako_binding_context ctx = {
+		.surface = seat->keyboard.surface != NULL ?
+			seat->keyboard.surface : surface,
+		.seat = seat,
+		.serial = serial,
+	};
+
+	notification_execute_binding(notif, binding, &ctx);
+	refresh_keyboard_grab(state);
+	set_dirty(surface);
+}
+
+static void handle_grab_key(struct mako_state *state, struct mako_seat *seat,
+		uint32_t serial, xkb_keysym_t sym) {
+	switch (sym) {
+	case XKB_KEY_Escape:
+	case XKB_KEY_q:
+		set_keyboard_grab(state, false);
+		return;
+	case XKB_KEY_j:
+	case XKB_KEY_Down:
+		grab_move_selection(state, 1);
+		return;
+	case XKB_KEY_k:
+	case XKB_KEY_Up:
+		grab_move_selection(state, -1);
+		return;
+	case XKB_KEY_Return:
+	case XKB_KEY_KP_Enter: {
+		const struct mako_binding binding = {
+			.action = MAKO_BINDING_INVOKE_ACTION,
+			.action_name = (char *)"default",
+		};
+		grab_invoke_binding(state, seat, serial, &binding);
+		return;
+	}
+	case XKB_KEY_d:
+	case XKB_KEY_Delete:
+	case XKB_KEY_BackSpace: {
+		const struct mako_binding binding = {
+			.action = MAKO_BINDING_DISMISS,
+		};
+		grab_invoke_binding(state, seat, serial, &binding);
+		return;
+	}
+	case XKB_KEY_D: {
+		const struct mako_binding binding = {
+			.action = MAKO_BINDING_DISMISS_ALL,
+		};
+		grab_invoke_binding(state, seat, serial, &binding);
+		return;
+	}
+	default:
+		break;
+	}
+
+	if (sym >= XKB_KEY_1 && sym <= XKB_KEY_9) {
+		struct mako_notification *notif = grab_selected_notification(state);
+		if (notif == NULL) {
+			return;
+		}
+		const char *action_name = grab_nth_action(notif, sym - XKB_KEY_1);
+		if (action_name == NULL) {
+			return;
+		}
+		const struct mako_binding binding = {
+			.action = MAKO_BINDING_INVOKE_ACTION,
+			.action_name = (char *)action_name,
+		};
+		grab_invoke_binding(state, seat, serial, &binding);
+	}
+}
+
+static void keyboard_handle_keymap(void *data, struct wl_keyboard *wl_keyboard,
+		uint32_t format, int32_t fd, uint32_t size) {
+	struct mako_seat *seat = data;
+
+	if (format != WL_KEYBOARD_KEYMAP_FORMAT_XKB_V1 ||
+			seat->keyboard.xkb_context == NULL) {
+		close(fd);
+		return;
+	}
+
+	char *map_shm = mmap(NULL, size, PROT_READ, MAP_PRIVATE, fd, 0);
+	if (map_shm == MAP_FAILED) {
+		close(fd);
+		return;
+	}
+
+	struct xkb_keymap *keymap = xkb_keymap_new_from_string(
+		seat->keyboard.xkb_context, map_shm, XKB_KEYMAP_FORMAT_TEXT_V1,
+		XKB_KEYMAP_COMPILE_NO_FLAGS);
+	munmap(map_shm, size);
+	close(fd);
+	if (keymap == NULL) {
+		return;
+	}
+
+	struct xkb_state *xkb_state = xkb_state_new(keymap);
+	if (xkb_state == NULL) {
+		xkb_keymap_unref(keymap);
+		return;
+	}
+
+	xkb_state_unref(seat->keyboard.xkb_state);
+	xkb_keymap_unref(seat->keyboard.xkb_keymap);
+	seat->keyboard.xkb_keymap = keymap;
+	seat->keyboard.xkb_state = xkb_state;
+}
+
