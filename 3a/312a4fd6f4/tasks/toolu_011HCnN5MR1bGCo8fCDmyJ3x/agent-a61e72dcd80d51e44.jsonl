# `serve` probes ORCA_APP_EXECUTABLE (orcaCli below) with\n106-    # ELECTRON_RUN_AS_NODE=1 and a script as argv, and Node rejects the flag\n107-    # (\"bad option\", exit 9), silently losing the orcad runtime. Node mode\n108-    # still goes through AppRun, which adds --no-sandbox -- just as fatal --\n109-    # if `unshare -Ur` fails in the sandbox; nested user namespaces work on\n110-    # these hosts, so it does not. Hand-written: clearer than makeShellWrapper\n111-    # with a --run early exec.\n112-    extraInstallCommands = ''\n113-      mv $out/bin/orca $out/bin/.orca-ide-unwrapped\n114-      cat > $out/bin/orca-ide-app <<'EOF'\n115-      #!${pkgs.runtimeShell}\n116-      if [ -z \"''${ELECTRON_RUN_AS_NODE:-}\" ]; then\n117-        set -- --ozone-platform=wayland \"$@\"\n118-      fi\n119:      ${forwardSignals \"${placeholder \"out\"}/bin/.orca-ide-unwrapped\"}\n120-      EOF\n121-      chmod +x $out/bin/orca-ide-app\n122-      install -Dm444 ${appimageContents}/orca-ide.desktop \\\n123-        $out/share/applications/orca-ide.desktop\n124-      for size in 16 24 32 48 64 128 256 512; do\n125-        install -Dm444 \\\n126-          ${appimageContents}/usr/share/icons/hicolor/''${size}x''${size}/apps/orca-ide.png \\\n127-          $out/share/icons/hicolor/''${size}x''${size}/apps/orca-ide.png\n128-      done\n129-      substituteInPlace $out/share/applications/orca-ide.desktop \\\n130-        --replace-fail 'Exec=AppRun' 'Exec=orca-ide-app'\n131-    '';\n132-    meta.mainProgram = \"orca-ide-app\";\n133-  };\n134-  # Hermetic: nixpkgs' own conf.d (store paths, the full standard alias set),\n135-  # whose 50-user.conf pulls in ~/.config/fontconfig -- home-manager's font\n136-  # dirs, i.e. the nix-profile fonts every other app here uses. Plus DejaVu:\n137-  # Orca's Linux terminalFontFamily default is exactly \"DejaVu Sans Mono\" with\n138-  # no fallback, and Chromium refuses fontconfig's alias to another mono font,\n139-  # so without it the terminal lays a proportional fallback out on a mono grid.\n140-  # Scoped to orca rather than the profile because only orca hardcodes it.\n141-  fontsConf = pkgs.writeText \"orca-fonts.conf\" ''\n142-    <?xml version=\"1.0\"?>\n143-    <!DOCTYPE fontconfig SYSTEM \"urn:fontconfig:fonts.dtd\">\n144-    <fontconfig>","is_error":false}]},"uuid":"0428157a-f723-40a8-b39d-616836c476a5","timestamp":"2026-10-24T12:01:33.469Z","toolUseResult":{"stdout":"commit acab1d5fd4c644c09c28c5d7766f5ad3c8af3147\nAuthor: Sauyon Lee <git@sjle.co>\nDate:   Sat Oct 24 12:01:02 2026 +0000\n\n    orca: forward INT off a terminal, survive Ctrl-C on one; GUI dies with its launcher\n    \n    Review round 5. `trap : INT` swallowed every SIGINT, but the serve\n    supervisor forwards INT to its child before SIGKILLing it; now INT is\n    forwarded unless the launcher's process group is the terminal's\n    foreground group, which Ctrl-C already reaches.\n    \n    On a terminal, Ctrl-C also reached bwrap, which died of it and\n    SIGKILLed the payload (--die-with-parent) before its handler ran --\n    true of the plain exec before this branch too. bwrap now starts with\n    INT ignored (env --ignore-signal=INT); Node resets inherited\n    dispositions and Chromium installs its own handler, so the payload\n    still gets it.\n    \n    dieWithParent = false is gone: the GUI's bwrap is the forwarding\n    shell's child now, and that shell outlives `orca-ide open`; dying with\n    it keeps a SIGKILLed launcher from orphaning Electron.\n    \n    A signal death is re-raised, so callers see the same status as a plain\n    exec, and a trap racing the child's exit no longer reports the trap's\n    status.\n    \n    Tests: bwrap's own SigIgn (the old SIGINT case could not fail, Node\n    resets its dispositions), INT forwarded off a terminal, Ctrl-C on a real\n    pty delivered once and handled (skipped without python3, as in CI), the\n    GUI's --die-with-parent present and the payload outliving a parent that\n    spawns it detached.\n    \n    Comments: macKeybindings uses appimageContents; master's keybindings.json\n    comment moves onto the activation it describes.\n    \n    Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>\n    Entire-Checkpoint: f2105f7d01b2\n\ndiff --git a/orca.nix b/orca.nix\nindex 74ad0d25..0f4eaecc 100644\n--- a/orca.nix\n+++ b/orca.nix\n@@ -1,34 +1,50 @@\n { config, lib, pkgs, machine, ... }:\n \n let\n-  # Run a bwrap launcher in the background and forward TERM and HUP to the\n-  # process inside its sandbox. bwrap forwards no signals: with\n-  # --die-with-parent a TERM SIGKILLs the payload before it can clean up,\n-  # without it the payload is orphaned. Either way `orca-ide serve` cannot\n-  # be stopped cleanly -- systemd's unit (KillMode=process), the serve\n-  # supervisor and a plain kill all signal the outermost pid. Without a pid\n+  # Run a bwrap launcher in the background and forward TERM, HUP and INT to\n+  # the process inside its sandbox. bwrap forwards no signals: under\n+  # --die-with-parent a TERM to it SIGKILLs the payload before it can clean\n+  # up. So `orca-ide serve` could not be stopped cleanly -- systemd's unit\n+  # (KillMode=process), the serve supervisor (TERM, HUP and INT, then\n+  # SIGKILL) and a plain kill all signal the outermost pid. Without a pid\n   # namespace (buildFHSEnv's default), bwrap's one child is the payload\n-  # itself, every layer below exec'ing the next.\n+  # itself, every layer below exec'ing the next. A signal death is\n+  # re-raised, so a calling shell sees the same status as with a plain exec.\n+  #\n+  # Ctrl-C: the terminal sends INT to the whole foreground group, so INT is\n+  # not forwarded when that group is ours, and bwrap starts with INT\n+  # ignored -- a bwrap that died of it would SIGKILL the payload through\n+  # --die-with-parent before its handler ran. The payload is unaffected:\n+  # Node resets inherited dispositions and Chromium installs its own SIGINT\n+  # handler. (A plain exec had the same bwrap problem; Ctrl-C was a kill.)\n   #\n   # A background job in a non-interactive shell gets stdin from /dev/null\n-  # and SIGINT/SIGQUIT ignored; `<&0` and env --default-signal undo both, so\n-  # stdin and Ctrl-C (which the terminal delivers to the whole foreground\n-  # group, payload included) behave as with a plain exec. tests/orca-cli-skills.sh.\n+  # and SIGQUIT ignored; `<&0` and env --default-signal undo both. Other\n+  # signals (QUIT, USR1, ...) kill the launcher unforwarded, as they killed\n+  # bwrap before. tests/orca-cli-skills.sh.\n   forwardSignals = target: ''\n     # forward-signals\n-    ${pkgs.coreutils}/bin/env --default-signal=INT,QUIT ${target} \"$@\" <&0 &\n+    ${pkgs.coreutils}/bin/env --ignore-signal=INT --default-signal=QUIT ${target} \"$@\" <&0 &\n     child=$!\n     fwd() {\n+      if [ \"$1\" = INT ]; then\n+        # Fields after \"(comm) \": state ppid pgrp session tty_nr tpgid.\n+        st=$(< /proc/$$/stat); read -ra st <<< \"''${st##*) }\"\n+        [ \"''${st[2]}\" = \"''${st[5]}\" ] && return\n+      fi\n       kids=$(cat /proc/$child/task/*/children 2>/dev/null)\n       kill -s \"$1\" ''${kids:-$child} 2>/dev/null\n     }\n-    trap 'fwd TERM' TERM\n-    trap 'fwd HUP' HUP\n-    trap : INT\n+    for sig in TERM HUP INT; do trap \"fwd $sig\" $sig; done\n+    # Over 128 is a trap interrupting wait, or the child's own signal death.\n     while :; do\n       wait $child; rc=$?\n-      kill -0 $child 2>/dev/null || exit $rc\n+      [ $rc -gt 128 ] && kill -0 $child 2>/dev/null || break\n     done\n+    # It may have exited between the trap and kill -0: its saved status wins.\n+    if [ $rc -gt 128 ]; then wait $child; r=$?; [ $r -ne 127 ] && rc=$r; fi\n+    if [ $rc -gt 128 ]; then trap - $((rc - 128)); kill -$((rc - 128)) $$; fi\n+    exit $rc\n   '';\n \n   isDarwin = pkgs.stdenv.hostPlatform.isDarwin;\n@@ -62,10 +78,10 @@ let\n     # so all of them dangled and every family fell to Montserrat Thin. See\n     # fontsConf below. tests/sandbox-fonts.sh.\n     extraBwrapArgs = [ \"--setenv FONTCONFIG_FILE ${fontsConf}\" ];\n-    # `orca-ide open` (orcaCli below) spawns the GUI detached, but every\n-    # wrapper layer execs the next, so this bwrap is the CLI's own child, and\n-    # --die-with-parent SIGKILLs the window the moment `open` returns.\n-    dieWithParent = false;\n+    # dieWithParent stays at buildFHSEnv's default: this bwrap's parent is\n+    # orca-ide-app's forwardSignals shell, which outlives an `orca-ide open`\n+    # that spawned it, and dying with that shell is what keeps a SIGKILLed\n+    # launcher (the serve supervisor's last resort) from orphaning Electron.\n     # The AppImage ships bin/orca and an orca-ide.desktop. Upstream's Linux\n     # install makes `orca-ide` the CLI, and Orca's skills tell agents to run\n     # exactly that outside an Orca terminal, so `orca-ide` is orcaCli below\n@@ -131,8 +147,9 @@ let\n       <cachedir prefix=\"xdg\">fontconfig</cachedir>\n     </fontconfig>\n   '';\n-  # Extracted once, shared by the GUI's extraInstallCommands and orcaCli's\n-  # runScript; let bindings are recursive, so position does not matter.\n+  # Extracted once, shared by the GUI's extraInstallCommands, orcaCli's\n+  # runScript and macKeybindings; let bindings are recursive, so position\n+  # does not matter.\n   appimageContents = pkgs.appimageTools.extract { inherit pname version src; };\n \n   # nixGL wrap: without it the FHS env resolves GBM/DRI via the NixOS-only\n@@ -165,7 +182,7 @@ let\n     runScript = \"${appimageContents}/resources/bin/orca-ide\";\n     extraBwrapArgs = [ \"--setenv ORCA_APP_EXECUTABLE ${orcaGui}/bin/orca-ide-app\" ];\n     # bin/orca-ide is buildFHSEnv's bwrap launcher; it moves aside so the\n-    # name is a forwardSignals wrapper, for `orca-ide serve` above all.\n+    # name is a forwardSignals wrapper, mainly for `orca-ide serve`.\n     extraInstallCommands = ''\n       mv $out/bin/orca-ide $out/bin/.orca-ide-bwrap\n       cat > $out/bin/orca-ide <<'EOF'\n@@ -274,13 +291,6 @@ let\n       cat merge.err >&2; echo \"orca: build-time merge did not apply the table\" >&2; exit 1\n     fi\n   '';\n-  # ~/.orca/keybindings.json is Orca's read-write state: its settings UI saves\n-  # into the same platforms.linux section, by atomic rename, so a home.file\n-  # symlink would be replaced on the first edit. So the generated keys are\n-  # merged into whatever Orca last wrote, owning only what the last merge\n-  # wrote (a sidecar records it), and a UI edit outranks them -- the rules\n-  # are at the top of nix/orca-mac-keybindings-merge.js.\n-  # tests/orca-mac-keybindings.sh.\n in\n {\n   home.packages =\n@@ -291,6 +301,13 @@ in\n     value.source = \"${orcaSkillsSrc}/skills/${name}\";\n   }) orcaSkills));\n \n+  # ~/.orca/keybindings.json is Orca's read-write state: its settings UI saves\n+  # into the same platforms.linux section, by atomic rename, so a home.file\n+  # symlink would be replaced on the first edit. So the generated keys are\n+  # merged into whatever Orca last wrote, owning only what the last merge\n+  # wrote (a sidecar records it), and a UI edit outranks them -- the rules\n+  # are at the top of nix/orca-mac-keybindings-merge.js.\n+  # tests/orca-mac-keybindings.sh.\n   home.activation.orcaMacKeybindings = lib.mkIf (!isDarwin && isDesktop)\n     (lib.hm.dag.entryAfter [ \"writeBoundary\" ] ''\n       $DRY_RUN_CMD ${macKeybindings}/bin/orca-mac-keybindings\n25:  forwardSignals = target: ''\n26-    # forward-signals\n27-    ${pkgs.coreutils}/bin/env --ignore-signal=INT --default-signal=QUIT ${target} \"$@\" <&0 &\n28-    child=$!\n29-    fwd() {\n30-      if [ \"$1\" = INT ]; then\n31-        # Fields after \"(comm) \": state ppid pgrp session tty_nr tpgid.\n32-        st=$(< /proc/$$/stat); read -ra st <<< \"''${st##*) }\"\n33-        [ \"''${st[2]}\" = \"''${st[5]}\" ] && return\n34-      fi\n35-      kids=$(cat /proc/$child/task/*/children 2>/dev/null)\n36-      kill -s \"$1\" ''${kids:-$child} 2>/dev/null\n37-    }\n38-    for sig in TERM HUP INT; do trap \"fwd $sig\" $sig; done\n39-    # Over 128 is a trap interrupting wait, or the child's own signal death.\n40-    while :; do\n41-      wait $child; rc=$?\n42-      [ $rc -gt 128 ] && kill -0 $child 2>/dev/null || break\n43-    done\n44-    # It may have exited between the trap and kill -0: its saved status wins.\n45-    if [ $rc -gt 128 ]; then wait $child; r=$?; [ $r -ne 127 ] && rc=$r; fi\n46-    if [ $rc -gt 128 ]; then trap - $((rc - 128)); kill -$((rc - 128)) $$; fi\n47-    exit $rc\n48-  '';\n49-\n50-  isDarwin = pkgs.stdenv.hostPlatform.isDarwin;\n51-  isDesktop = machine.gui or true;\n52-\n53-  # Orca (onorca.dev) — the agent IDE: parallel CLI agents, each in its own\n54-  # worktree. Closed-source Electron app, not in nixpkgs (nixpkgs' `orca` is\n55-  # the GNOME screen reader), so this packages the official Linux AppImage.\n56-  # The electron-updater feed in each GitHub release, latest-linux.yml, is\n57-  # the source of truth for version + sha512 when bumping: the yml's sha512\n58-  # is the AppImage's, checked against\n59-  # the download with `nix hash to-sri --type sha512 <sha512sum>`.\n60-  # https://github.com/stablyai/orca/releases/latest/download/latest-linux.yml\n61-  pname = \"orca\";\n62-  version = \"1.4.238\";\n63-  src = pkgs.fetchurl {\n64-    url = \"https://github.com/stablyai/orca/releases/download/v${version}/orca-linux.AppImage\";\n65-    hash = \"REDACTED/sHSKlfJa4c1O2MCcdJhLrxCVm/NVKT+JtghzxoEsQ==\";\n66-  };\n67-\n68-  # Wrap the AppImage (not autoPatchelf of the .deb) so the Electron stack\n69-  # runs in appimageTools' FHS env, which works on non-NixOS hosts. Electron\n70-  # safeStorage wants libsecret at runtime.\n71-  orca = pkgs.appimageTools.wrapType2 {\n72-    inherit pname version src;\n73-    extraPkgs = pkgs: [ pkgs.libsecret ];\n74-    # The sandbox gets its own fontconfig, the way every other nix GUI app here\n75-    # gets a nix-generated FONTCONFIG_FILE, instead of the distro's.\n76-    # buildFHSEnv binds the host's /etc/fonts in, assuming NixOS; Arch's conf.d\n77-    # links point into /usr/share/fontconfig, which the sandbox's /usr replaces,\n78-    # so all of them dangled and every family fell to Montserrat Thin. See\n79-    # fontsConf below. tests/sandbox-fonts.sh.\n80-    extraBwrapArgs = [ \"--setenv FONTCONFIG_FILE ${fontsConf}\" ];\n81-    # dieWithParent stays at buildFHSEnv's default: this bwrap's parent is\n82:    # orca-ide-app's forwardSignals shell, which outlives an `orca-ide open`\n83-    # that spawned it, and dying with that shell is what keeps a SIGKILLed\n84-    # launcher (the serve supervisor's last resort) from orphaning Electron.\n85-    # The AppImage ships bin/orca and an orca-ide.desktop. Upstream's Linux\n86-    # install makes `orca-ide` the CLI, and Orca's skills tell agents to run\n87-    # exactly that outside an Orca terminal, so `orca-ide` is orcaCli below\n88-    # and the GUI is `orca-ide-app`, which the desktop Exec and\n89-    # meta.mainProgram use. appimageTools keeps the AppImage's own bin name,\n90-    # so the wrapper is renamed by hand.\n91-    #\n92-    # --ozone-platform=wayland: Orca's startup gate picks X11 when neither\n93-    # --ozone-platform nor ELECTRON_OZONE_PLATFORM_HINT says otherwise, and on\n94-    # a Hyprland-only session there is no X server to stat — measured: the\n95-    # bare launch exits 1 with \"needs a usable display server\", and the\n96-    # explicit wayland switch keeps it running (timeout kill at 20s, exit 124).\n97-    # An env var would work from a shell but not a desktop-file launch, so it\n98-    # is a flag on the command line.\n99-    #\n100-    # The flag lands in extraInstallCommands, not postFixup: wrapType2 is a\n101-    # buildFHSEnv, whose buildCommand short-circuits genericBuild's phase\n102-    # list, so postFixup never runs. The bwrap launcher moves aside to\n103:    # .orca-ide-unwrapped and orca-ide-app becomes a forwardSignals wrapper\n104-    # that prepends the flag and passes \"$@\" through -- except in node mode: the CLI's\n105-    # `serve` probes ORCA_APP_EXECUTABLE (orcaCli below) with\n106-    # ELECTRON_RUN_AS_NODE=1 and a script as argv, and Node rejects the flag\n107-    # (\"bad option\", exit 9), silently losing the orcad runtime. Node mode\n108-    # still goes through AppRun, which adds --no-sandbox -- just as fatal --\n109-    # if `unshare -Ur` fails in the sandbox; nested user namespaces work on\n110-    # these hosts, so it does not. Hand-written: clearer than makeShellWrapper\n111-    # with a --run early exec.\n112-    extraInstallCommands = ''\n113-      mv $out/bin/orca $out/bin/.orca-ide-unwrapped\n114-      cat > $out/bin/orca-ide-app <<'EOF'\n115-      #!${pkgs.runtimeShell}\n116-      if [ -z \"''${ELECTRON_RUN_AS_NODE:-}\" ]; then\n117-        set -- --ozone-platform=wayland \"$@\"\n118-      fi\n119:      ${forwardSignals \"${placeholder \"out\"}/bin/.orca-ide-unwrapped\"}\n120-      EOF\n121-      chmod +x $out/bin/orca-ide-app\n122-      install -Dm444 ${appimageContents}/orca-ide.desktop \\\n123-        $out/share/applications/orca-ide.desktop\n124-      for size in 16 24 32 48 64 128 256 512; do\n125-        install -Dm444 \\\n126-          ${appimageContents}/usr/share/icons/hicolor/''${size}x''${size}/apps/orca-ide.png \\\n127-          $out/share/icons/hicolor/''${size}x''${size}/apps/orca-ide.png\n128-      done\n129-      substituteInPlace $out/share/applications/orca-ide.desktop \\\n130-        --replace-fail 'Exec=AppRun' 'Exec=orca-ide-app'\n131-    '';\n132-    meta.mainProgram = \"orca-ide-app\";\n133-  };\n134-  # Hermetic: nixpkgs' own conf.d (store paths, the full standard alias set),\n135-  # whose 50-user.conf pulls in ~/.config/fontconfig -- home-manager's font\n136-  # dirs, i.e. the nix-profile fonts every other app here uses. Plus DejaVu:\n137-  # Orca's Linux terminalFontFamily default is exactly \"DejaVu Sans Mono\" with\n138-  # no fallback, and Chromium refuses fontconfig's alias to another mono font,\n139-  # so without it the terminal lays a proportional fallback out on a mono grid.\n140-  # Scoped to orca rather than the profile because only orca hardcodes it.\n141-  fontsConf = pkgs.writeText \"orca-fonts.conf\" ''\n142-    <?xml version=\"1.0\"?>\n143-    <!DOCTYPE fontconfig SYSTEM \"urn:fontconfig:fonts.dtd\">\n144-    <fontconfig>","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"e4121411-cab6-4176-beb8-7adf3fa23c36","context":{"git_state":{"cwd":"/home/sauyon/devel/dotfiles/.drovr/wt/orca-cli-skills","root":"/home/sauyon/devel/dotfiles/.drovr/wt/orca-cli-skills","branch":"orca-cli-skills","default_branch":null,"status":{"clean":true,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"forge.ko.ag","remote":"sauyon/dotfiles","visibility":"unknown"},"push_remote":"origin","remotes":[{"name":"origin","host":"forge.ko.ag","remote":"sauyon/dotfiles","visibility":"unknown"}],"visibility_cache":[{"host":"forge.ko.ag","remote":"sauyon/dotfiles","visibility":"unknown"}]}},"live_cwd":"/home/sauyon/devel/dotfiles/.drovr/wt/orca-cli-skills","platform":"linux"}},"sandboxed":false,"sourceToolAssistantUUID":"40cb9765-8c2d-472d-93f7-b4976ee5b579","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"userType":"external","entrypoint":"cli","cwd":"/home/sauyon/devel/dotfiles/.drovr/wt/orca-cli-skills","sessionId":"d19ff9ff-38c8-4378-ac54-4f4061f74300","version":"2.1.308","gitBranch":"master"}
