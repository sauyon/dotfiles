[Unit]
Description=drovr review server firewall (tcp/8791 allowlist)
Documentation=file:/etc/nftables.d/drovr.nft
# Ordering only. The ruleset names enp191s0 and tailscale0, but nft accepts an
# iifname that does not resolve yet, so a missing interface delays nothing.
# nftables.service is DISABLED on this host on purpose -- its stock Arch ruleset
# is default-drop on input AND forward and would break this Kubernetes node. It
# is named here so that if anyone ever enables it, this table loads after it
# rather than racing it.
After=network-pre.target nftables.service
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/nft -f /etc/nftables.d/drovr.nft
# The ruleset opens with `destroy table`, so ExecStart is idempotent on its own.
# This makes `systemctl stop` genuinely remove the rules instead of leaving them
# in place with the unit reported inactive. `destroy` (nftables >= 1.0.8; this
# host runs 1.1.6) succeeds on an absent table, where `delete` would fail.
ExecStop=/usr/bin/nft destroy table inet drovr

[Install]
WantedBy=multi-user.target
