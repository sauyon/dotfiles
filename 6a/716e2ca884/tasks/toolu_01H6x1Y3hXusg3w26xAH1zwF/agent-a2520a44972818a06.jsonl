apped\n    98\t      cat > $out/bin/orca-ide-app <<'EOF'\n    99\t      #!${pkgs.runtimeShell}\n   100\t      if [ -z \"''${ELECTRON_RUN_AS_NODE:-}\" ]; then\n   101\t        set -- --ozone-platform=wayland \"$@\"\n   102\t      fi\n   103\t      ${forwardSignals \"${placeholder \"out\"}/bin/.orca-ide-unwrapped\"}\n   104\t      EOF\n   105\t      chmod +x $out/bin/orca-ide-app\n   106\t      install -Dm444 ${appimageContents}/orca-ide.desktop \\\n   107\t        $out/share/applications/orca-ide.desktop\n   108\t      for size in 16 24 32 48 64 128 256 512; do\n   109\t        install -Dm444 \\\n   110\t          ${appimageContents}/usr/share/icons/hicolor/''${size}x''${size}/apps/orca-ide.png \\\n   111\t          $out/share/icons/hicolor/''${size}x''${size}/apps/orca-ide.png\n   112\t      done\n   113\t      substituteInPlace $out/share/applications/orca-ide.desktop \\\n   114\t        --replace-fail 'Exec=AppRun' 'Exec=orca-ide-app'\n   115\t    '';\n   116\t    meta.mainProgram = \"orca-ide-app\";\n   117\t  };\n   118\t  # Hermetic: nixpkgs' own conf.d (store paths, the full standard alias set),\n   119\t  # whose 50-user.conf pulls in ~/.config/fontconfig -- home-manager's font\n   120\t  # dirs, i.e. the nix-profile fonts every other app here uses. Plus DejaVu:\n   121\t  # Orca's Linux terminalFontFamily default is exactly \"DejaVu Sans Mono\" with\n   122\t  # no fallback, and Chromium refuses fontconfig's alias to another mono font,\n   123\t  # so without it the terminal lays a proportional fallback out on a mono grid.\n   124\t  # Scoped to orca rather than the profile because only orca hardcodes it.\n   125\t  fontsConf = pkgs.writeText \"orca-fonts.conf\" ''\n   126\t    <?xml version=\"1.0\"?>\n   127\t    <!DOCTYPE fontconfig SYSTEM \"urn:fontconfig:fonts.dtd\">\n   128\t    <fontconfig>\n   129\t      <include ignore_missing=\"no\">${pkgs.fontconfig.out}/etc/fonts/conf.d</include>\n   130\t      <dir>${pkgs.dejavu_fonts}/share/fonts</dir>\n   131\t      <cachedir prefix=\"xdg\">fontconfig</cachedir>\n   132\t    </fontconfig>\n   133\t  '';\n   134\t  # Extracted once, shared by the GUI's extraInstallCommands and orcaCli's\n   135\t  # runScript; let bindings are recursive, so position does not matter.\n   136\t  appimageContents = pkgs.appimageTools.extract { inherit pname version src; };\n   137\t\n   138\t  # nixGL wrap: without it the FHS env resolves GBM/DRI via the NixOS-only\n   139\t  # /run/opengl-driver path and falls back to software rendering — the\n   140\t  # same reason parsec gets it.\n   141\t  orcaGui = config.lib.nixGL.wrap orca;\n   142\t\n   143\t  # The CLI, as `orca-ide` (what the skills run outside an Orca terminal on\n   144\t  # Linux) and `orca` (their name for it elsewhere; inside an Orca terminal\n   145\t  # the app's own shim dir comes first on PATH and wins). Upstream's\n   146\t  # resources/bin/orca-ide runs the bundled Electron in node mode on\n   147\t  # out/cli/index.js. Orca's own installer only reaches an Orca terminal: a\n   148\t  # shim dir on PATH there, and a ~/.local/bin symlink to a raw store path\n   149\t  # that runs Electron against the host's libraries. This runs that same\n   150\t  # script in an FHS env of its own, so it works from any shell. Its own,\n   151\t  # not the GUI's: wrapType2 pins runScript to appimage-exec.sh, whose AppRun execs the\n   152\t  # Electron binary and never the CLI script. defaultFhsEnvArgs already\n   153\t  # carries libsecret.\n   154\t  #\n   155\t  # ORCA_APP_EXECUTABLE: `orca-ide open` otherwise spawns process.execPath,\n   156\t  # the raw Electron in this env — no wayland flag, fonts or nixGL, so it\n   157\t  # exits on a Hyprland-only session. The CLI's launcher honours this\n   158\t  # override and strips ELECTRON_RUN_AS_NODE before spawning it; `serve`\n   159\t  # also runs it in node mode, which orca-ide-app above allows for.\n   160\t  # tests/orca-cli-skills.sh.\n   161\t  orcaCli = pkgs.buildFHSEnv (pkgs.appim