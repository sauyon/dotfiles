# Triggered by sauyon-user-units-rescan.path once /home/sauyon is mounted.
#
# Poke sauyon's already-running systemd user manager so it picks up the unit files that
# only became readable when the encrypted home was unlocked:
#
#   daemon-reload        rescan the unit search path (which 10-home.conf already pinned
#                        to the correct location) so the units exist
#   start default.target pull in everything enabled via default.target.wants/, which the
#                        manager skipped when it reached default.target with an empty
#                        search path
#
# Both are idempotent: on a normal physical login the manager is already healthy and
# default.target is already active, so this is a no-op. ExecStart is prefixed with `-`
# because the user manager may legitimately not be running yet, in which case there is
# nothing to poke -- it will start later with a mounted home and be correct anyway.
#
# RemainAfterExit=yes is load-bearing, not cosmetic: a .path unit with PathExists=
# re-triggers as soon as the unit it activates goes inactive, and the path still exists,
# so a plain oneshot spins until it trips the start rate limit (observed:
# "Start request repeated too quickly", start-limit-hit). Staying "active" holds the
# path unit off. BindsTo=home-sauyon.mount then stops this service if the home is ever
# deactivated, which re-arms the path unit for the next unlock.
[Unit]
Description=Rescan sauyon's user units after the homed home is mounted
After=home-sauyon.mount
BindsTo=home-sauyon.mount

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=-/usr/bin/systemctl --machine=sauyon@.host --user daemon-reload
ExecStart=-/usr/bin/systemctl --machine=sauyon@.host --user start default.target
