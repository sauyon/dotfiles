+func TestBuildSupervisorServiceDataPersistsGCRuntimeDir(t *testing.T) {
+	homeDir := t.TempDir()
+	runtimeDir := filepath.Join(t.TempDir(), "gc-run")
+	t.Setenv("HOME", homeDir)
+	t.Setenv("GC_HOME", filepath.Join(homeDir, ".gc"))
+	t.Setenv("PATH", "/usr/local/bin:/usr/bin:/bin")
+	t.Setenv("XDG_RUNTIME_DIR", "/tmp/gc-run")
+	t.Setenv("GC_RUNTIME_DIR", runtimeDir)
+
+	data, err := buildSupervisorServiceData()
+	if err != nil {
+		t.Fatalf("buildSupervisorServiceData: %v", err)
+	}
+	if got := supervisorServiceEnvMap(data.ExtraEnv)["GC_RUNTIME_DIR"]; got != runtimeDir {
+		t.Fatalf("ExtraEnv[GC_RUNTIME_DIR] = %q, want %q", got, runtimeDir)
+	}
+}
