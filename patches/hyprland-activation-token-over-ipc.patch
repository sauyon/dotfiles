+// Hand out an xdg-activation token over IPC, so a notification daemon or
+// launcher driven from a keybind can pass one to the app it is acting for and
+// have that app raise the window the action actually belongs to. The app picks
+// the surface, which is strictly more precise than the caller guessing at it by
+// pid or class -- one process routinely owns several windows.
+//
+// This grants no authority the caller did not already have: anything that can
+// reach this socket can already `hyprctl dispatch focuswindow`, which focuses
+// unconditionally, where CWindow::activate() still honours misc:focus_on_activate
+// and per-window suppressevent rules. The token is single-use, spent by the
+// activate request, and short-lived so it is not worth capturing in transit.
+static std::string activationTokenRequest(eHyprCtlOutputFormat format, std::string request) {
+    const auto TOKEN = PROTO::activation->mintTokenForIPC(std::chrono::seconds(10));
+
+    if (format == eHyprCtlOutputFormat::FORMAT_JSON)
+        return std::format(R"#(
+{{
+    "token": "{}"
+}}
+)#",
+                           TOKEN);
+
+    return TOKEN + "\n";
+}
