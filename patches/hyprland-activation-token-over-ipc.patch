 }
 
+std::string CXDGActivationProtocol::mintTokenForIPC(std::chrono::steady_clock::duration expires) {
+    const auto TOKEN = m_sentTokens.emplace_back(makeUnique<CHyprlandActivationToken>(nullptr, true, expires))->token();
+
+    // Client-minted tokens are capped per client by cleanupTokens(). Tokens
+    // minted here share a null client, so cap them the same way rather than
+    // letting a caller grow the vector without bound.
+    size_t count = std::ranges::count_if(m_sentTokens, [](const auto& other) { return other->client() == nullptr; });
+    while (count > 10) {
+        for (auto i = m_sentTokens.begin(); i != m_sentTokens.end(); ++i) {
+            if (i->get()->client() == nullptr) {
+                m_sentTokens.erase(i);
+                break;
+            }
+        }
+        --count;
+    }
+
+    return TOKEN;
+}
+
 void CXDGActivationProtocol::onManagerResourceDestroy(wl_resource* res) {
     std::erase_if(m_managers, [&](const auto& other) { return other->resource() == res; });
 }
