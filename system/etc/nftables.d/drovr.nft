#!/usr/bin/nft -f
# drovr review server (tcp/8791) -- port-scoped allowlist.
#
# A SEPARATE TABLE, deliberately. fujiwara is a Kubernetes node: cilium and
# kube-proxy own `table ip filter` / `table ip nat` and rewrite them at will, and
# Arch's stock /etc/nftables.conf is a default-DROP input AND forward ruleset
# that would take this node off the network the moment nftables.service was
# enabled. Neither is touched here, and nftables.service stays disabled -- this
# is its own `inet drovr` table on its own hook.
#
# WHY IT EXISTS. `drovr serve` has NO authentication: anything that can reach it
# reads every run and can answer its asks, and drovr runs agents that write code
# and execute commands. Binding the server to 0.0.0.0 is what makes that
# reachable from the pod network -- 85 veths and 10.42.0.0/16 land on this host
# -- which turns a container compromise into control of the developer's agent
# runs. This closes that path and keeps the LAN one open.

destroy table inet drovr

table inet drovr {
  # Who may reach the UI over the LAN. Seeded with the whole /16 because that is
  # the reachability that was asked for, NOT because it is tight: IoT and guest
  # devices share this range. Narrow it to the machines you actually use --
  # `elements = { 10.0.7.100, 10.0.7.42 }` -- and it becomes "my hosts" rather
  # than "the house network". Editing this line is the whole change.
  set allowed_v4 {
    type ipv4_addr
    flags interval
    elements = { 10.0.0.0/16 }
  }

  # The OTHER cluster nodes, dropped ahead of the LAN allowlist above.
  #
  # This set is the whole reason the allowlist is not sufficient on its own, and
  # it is not obvious: cilium runs with `enable-ipv4-masquerade: true` in tunnel
  # mode, so a pod on meiko reaching 10.0.7.100 does NOT arrive as 10.42.x.x over
  # a cilium interface -- it arrives on enp191s0 with the source rewritten to
  # meiko's own LAN address, 10.0.7.110, which sits squarely inside the
  # 10.0.0.0/16 accepted above. Measured, not assumed: before this file existed,
  # a curl pod scheduled onto meiko got HTTP 200 from this server.
  #
  # So the iifname check alone only stops pods on THIS host. Pods anywhere else
  # in the cluster are indistinguishable from their node unless the node itself
  # is excluded.
  #
  # fujiwara (10.0.7.100) is deliberately absent: it is this host, and host-local
  # traffic to its own address is how the drovr CLI talks to its own server.
  #
  # ADD A ROW WHEN YOU ADD A NODE. A new worker is a new hole here, and nothing
  # will tell you -- the symptom is silence, which is what this rule set is for.
  set cluster_nodes {
    type ipv4_addr
    elements = { 10.0.7.1, 10.0.7.2, 10.0.7.110 }  # yui, mio, meiko
  }

  chain input {
    # priority -10 puts this ahead of cilium/kube-proxy's filter hooks (priority
    # 0), so the verdict is deterministic instead of registration-order
    # dependent.
    #
    # policy accept, and EVERY rule below is qualified by `tcp dport 8791`. That
    # is load-bearing: a bare `accept`/`drop` here would apply to all of the
    # host's traffic. An earlier draft opened with `tcp dport != 8791 accept`,
    # which looks equivalent and is not -- a UDP or ICMP packet has no TCP header
    # to compare, so it matched nothing and fell through to the drop at the
    # bottom, silently blackholing DNS and ping.
    type filter hook input priority -10; policy accept;

    # Host-local. Broader than 127.0.0.0/8 on purpose: the drovr CLI on this box
    # connects to the server's bound address, so 10.0.7.100 -> 10.0.7.100 also
    # lands here with iif lo, and narrowing this to loopback addresses would cut
    # `drovr ask wait` off from its own server.
    tcp dport 8791 iif lo accept
    # Tailnet: tailscaled has already authenticated the peer by this point.
    tcp dport 8791 iifname "tailscale0" accept
    # Before the LAN allowlist, not after -- see the cluster_nodes comment. First
    # match wins in nftables, so ordering is the whole control here.
    tcp dport 8791 ip saddr @cluster_nodes counter drop
    # LAN, allowlist only. `ip saddr` matches IPv4 alone, so IPv6 -- including
    # this host's globally-routable 2601:... address -- never matches and falls
    # to the drop below. The server binds 0.0.0.0 (v4-only) anyway; this is the
    # belt to that suspenders.
    tcp dport 8791 iifname "enp191s0" ip saddr @allowed_v4 accept

    # Everything else asking for 8791: the pod network arriving over lxc* and
    # cilium_host, and any IPv6. Counted, so `nft list table inet drovr` shows
    # whether it has ever actually fired.
    tcp dport 8791 counter drop
  }
}
