#!/usr/bin/env bash
# Re-activate the Kon WireGuard profile when the link underneath it changes.
#
# Why this is needed: NetworkManager leaves a WireGuard device `activated`
# across a default-route change. A tunnel brought up on one network therefore
# stays nominally up on the next one -- the kernel keeps re-initiating a
# handshake every 5s forever, which is WireGuard's own and only self-heal, and
# it cannot help when the initiations no longer reach the peer. Observed on
# shiori: activated on one SSID, carried across two more, TX and tx_dropped
# climbing while RX sat frozen at the same byte for 16 hours, until a manual
# deactivate/reactivate fixed it in two seconds.
#
# NM dispatcher contract: $1 is the interface, $2 the action.
set -u

iface=${1-}
action=${2-}
WG=Kon-shiori

# Never act on our own device. Reactivating $WG fires another `up`, this time
# for $WG itself, and acting on that would reactivate forever.
[ "$iface" = "$WG" ] && exit 0

case "$action" in
  up | dhcp4-change | dhcp6-change) ;;
  *) exit 0 ;;
esac

# Only rebind a tunnel that is already up. A profile the operator deactivated on
# purpose must stay down -- this hook exists to repair a stale binding, not to
# decide that the tunnel should be running.
state=$("${NMCLI-nmcli}" -g GENERAL.STATE con show "$WG" 2>/dev/null) || exit 0
[ "$state" = activated ] || exit 0

exec "${NMCLI-nmcli}" con up "$WG"
