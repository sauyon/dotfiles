+
+static void keyboard_handle_key(void *data, struct wl_keyboard *wl_keyboard,
+		uint32_t serial, uint32_t time, uint32_t key, uint32_t key_state) {
+	struct mako_seat *seat = data;
+	struct mako_state *state = seat->state;
+
+	if (key_state != WL_KEYBOARD_KEY_STATE_PRESSED || !state->grab.active ||
+			seat->keyboard.xkb_state == NULL) {
+		return;
+	}
